@{
    ViewData["Title"] = "Coordinator Sign In";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-5">
            
            <!-- Standardized Login Card -->
            <div class="glass-card" style="border-top: 5px solid var(--deped-blue); padding: 2.5rem; background: white;">
                <div class="text-center mb-4">
                    <h2 class="fw-bold" style="font-family: var(--font-header); color: var(--deped-blue);">
                        <i class="bi bi-shield-lock-fill" style="color: var(--golden-yellow);"></i> LOGIN
                    </h2>
                    <p class="text-muted fw-bold" style="font-size: 0.9rem; font-family: var(--font-body);">Calape District Meet Management Console</p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success py-2 px-3 border-0 rounded mb-3 fw-bold" style="font-size: 0.85rem;">
                        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 px-3 border-0 rounded mb-3 fw-bold" style="font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Username</label>
                        <input type="text" name="username" class="form-control" style="border: 1px solid #dee2e6; border-radius: 6px; padding: 0.75rem 1rem;" placeholder="Enter username" required autocomplete="username" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Password</label>
                        <input type="password" name="password" class="form-control" style="border: 1px solid #dee2e6; border-radius: 6px; padding: 0.75rem 1rem;" placeholder="••••••••" required autocomplete="current-password" />
                    </div>

                    <!-- Using the athletic slanted button theme -->
                    <button type="submit" class="btn-athletic w-100 mb-2">
                        <span>Access Dashboard</span>
                    </button>
                    
                    <!-- Reset Password Prompt Button -->
                    <button type="button" class="btn btn-light border w-100 fw-bold text-muted" style="font-size: 0.9rem;" onclick="alert('Please contact the System Administrator to request a password reset.');">
                        <i class="bi bi-key-fill me-1"></i> Forgot Password?
                    </button>
                </form>
            </div>
            
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem; font-family: var(--font-body);">
                    <i class="bi bi-house-door"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>