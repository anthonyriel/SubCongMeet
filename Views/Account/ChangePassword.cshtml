@{
    ViewData["Title"] = "Update Password Required";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-5">
            
            <div class="glass-card" style="border-top: 5px solid var(--golden-yellow); padding: 2.5rem; background: white;">
                <div class="text-center mb-4">
                    <h2 class="fw-bold" style="font-family: var(--font-header); color: var(--deped-blue);">
                        <i class="bi bi-key-fill text-warning"></i> ACTION REQUIRED
                    </h2>
                    <p class="text-muted fw-bold" style="font-size: 0.9rem; font-family: var(--font-body);">
                        For your security, you must update your default password before accessing the dashboard.
                    </p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 px-3 border-0 rounded mb-3 fw-bold" style="font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">New Password</label>
                        <input type="password" name="newPassword" class="form-control" style="border: 1px solid #dee2e6; border-radius: 6px; padding: 0.75rem 1rem;" placeholder="Enter new password" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" style="border: 1px solid #dee2e6; border-radius: 6px; padding: 0.75rem 1rem;" placeholder="Re-type new password" required />
                    </div>

                    <button type="submit" class="btn-athletic w-100" style="background-color: var(--deped-blue);">
                        <span>Update Password</span>
                    </button>
                </form>
            </div>
            
        </div>
    </div>
</div>