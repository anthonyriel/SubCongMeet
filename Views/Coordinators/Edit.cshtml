@model SubcongMeet.Models.Coordinator
@{
    ViewData["Title"] = "Edit Coordinator";
}

<style>
    .form-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border-top: 5px solid var(--golden-yellow);
    }
    
    .form-control-custom {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem 1rem;
    }

    /* Styles to seamlessly integrate the custom input with the button */
    .input-group > .form-control-custom {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }
    
    .input-group > .btn-reset {
        border-top-right-radius: 6px;
        border-bottom-right-radius: 6px;
        border: 1px solid #dee2e6;
        border-left: none;
        background-color: #f8f9fa;
        color: var(--deped-blue);
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }
    
    .input-group > .btn-reset:hover {
        background-color: #e9ecef;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card p-4 p-md-5">
                <h3 class="fw-bold mb-4" style="font-family: var(--font-header); color: var(--deped-blue);">
                    <i class="bi bi-pencil-square text-warning me-2"></i>MODIFY CREDENTIALS
                </h3>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Full Name</label>
                        <input asp-for="FullName" class="form-control form-control-custom" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted text-uppercase">Username</label>
                        <input asp-for="Username" class="form-control form-control-custom" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Update Password</label>
                        <div class="input-group">
                            <input asp-for="Password" type="text" id="PasswordInput" class="form-control form-control-custom" placeholder="New or existing password" required />
                            <button class="btn btn-reset px-3" type="button" onclick="resetPassword()" title="Reset to Default Password">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                            </button>
                        </div>
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-info-circle me-1"></i> Click reset to change the password to the default ("coordinator").
                        </small>
                    </div>

                    <div class="mb-4 p-3 bg-light rounded border d-flex align-items-center gap-3">
                        <input asp-for="IsAdmin" class="form-check-input ms-0" type="checkbox" id="isAdminSwitch" style="transform: scale(1.2);">
                        <label class="form-check-label fw-bold text-dark" for="isAdminSwitch" style="font-size: 0.9rem;">Global Administrator Access</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-athletic flex-grow-1" style="background-color: var(--deped-blue);"><span>Update Changes</span></button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function resetPassword() {
            // Prompts the user to ensure they want to reset the password
            if (confirm("Are you sure you want to reset this user's password to the default ('coordinator')?")) {
                document.getElementById("PasswordInput").value = "coordinator";
            }
        }
    </script>
}