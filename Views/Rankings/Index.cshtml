@model IEnumerable<SubcongMeet.Models.MedalTally>
@{
    ViewData["Title"] = "Overall Team Rankings";
    var recentResults = ViewBag.RecentResults as List<SubcongMeet.Models.Event> ?? new List<SubcongMeet.Models.Event>();
    var teamNames = ViewBag.Teams as Dictionary<int, string> ?? new Dictionary<int, string>();
    
    int eventsRecorded = recentResults.Count;
    int totalEvents = ViewBag.TotalEvents ?? 0;
    
    // Core Philippine Standard Time (PST - UTC+8) Utility
    string FormatToPst(DateTime? dt, string format = "MMM dd, yyyy • h:mm tt") {
        if (!dt.HasValue) return "N/A";
        
        DateTime utcDateTime;
        if (dt.Value.Kind == DateTimeKind.Utc) {
            utcDateTime = dt.Value;
        } else if (dt.Value.Kind == DateTimeKind.Local) {
            utcDateTime = dt.Value.ToUniversalTime();
        } else {
            utcDateTime = DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc);
        }
            
        return utcDateTime.AddHours(8).ToString(format);
    }

    DateTime? lastUpdateUtc = recentResults.Any() ? recentResults.Max(r => r.UpdatedAt) : null;
    string lastUpdatedString = lastUpdateUtc.HasValue ? FormatToPst(lastUpdateUtc.Value, "MM/dd/yy • h:mm tt") : FormatToPst(DateTime.UtcNow, "MM/dd/yy • h:mm tt");

    string GetHouseText(string name) {
        if(string.IsNullOrEmpty(name)) return "var(--cc-primary, #102A43)";
        if(name.Contains("Loon", StringComparison.OrdinalIgnoreCase)) return "#C9A227"; 
        if(name.Contains("Calape", StringComparison.OrdinalIgnoreCase)) return "#102A43"; 
        if(name.Contains("Tubigon", StringComparison.OrdinalIgnoreCase)) return "#7A1F2B"; 
        return "var(--cc-primary, #102A43)";
    }

    // Helper to map schools to LoCaTu municipalities for Overall standings
    string GetLocatuMunicipality(string name) {
        if (string.IsNullOrEmpty(name)) return "Calape";
        if (name.Contains("Loon", StringComparison.OrdinalIgnoreCase)) return "Loon";
        if (name.Contains("Tubigon", StringComparison.OrdinalIgnoreCase)) return "Tubigon";
        return "Calape";
    }

    // Build a lookup dictionary for acronyms based on the Model
    var acronymMap = new Dictionary<string, string>();
    foreach (var tally in Model)
    {
        if (tally.Team != null && !string.IsNullOrEmpty(tally.Team.Name))
        {
            acronymMap[tally.Team.Name] = !string.IsNullOrEmpty(tally.Team.Acronym) ? tally.Team.Acronym : tally.Team.Name;
        }
    }

    // Helper to fetch the acronym for the Recent Updates feed
    string GetTeamDisplayName(int teamId)
    {
        if (!teamNames.ContainsKey(teamId)) return "Unknown Team";
        string fullName = teamNames[teamId];
        return acronymMap.ContainsKey(fullName) ? acronymMap[fullName] : fullName;
    }

    // Pre-sort the standings by Gold, Silver, Bronze, and then Alphabetically by Team Name for ties (Secondary/Elementary)
    var sortedStandings = Model
        .OrderByDescending(t => t.Gold)
        .ThenByDescending(t => t.Silver)
        .ThenByDescending(t => t.Bronze)
        .ThenBy(t => t.Team?.Name ?? "")
        .ToList();

    // Compute Combined Overall Standings grouped by Municipality (LoCaTu)
    var overallStandings = Model
        .GroupBy(t => GetLocatuMunicipality(t.Team?.Name ?? string.Empty))
        .Select(g => new {
            Municipality = g.Key,
            Gold = g.Sum(x => x.Gold),
            Silver = g.Sum(x => x.Silver),
            Bronze = g.Sum(x => x.Bronze),
            Total = g.Sum(x => x.Gold + x.Silver + x.Bronze)
        })
        .OrderByDescending(x => x.Gold)
        .ThenByDescending(x => x.Silver)
        .ThenByDescending(x => x.Bronze)
        .ThenBy(x => x.Municipality)
        .ToList();
}

<style>
    /* ========================================== */
    /* MASTER OPACITY & COLOR CONTROL             */
    :root {
        --card-opacity: 1.0; 
    }
    /* ========================================== */

    body {
        background-color: var(--cc-background) !important; 
    }

    /* Themed Page Header */
    .page-header {
        color: var(--cc-primary, #102A43);
        border-bottom: 3px solid var(--cc-gold, #C9A227);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }
    .page-header h1 {
        color: var(--cc-primary, #102A43);
    }

    /* Animated Gradient Core Setup */
    @@keyframes gradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    /* Uniform Cards Styling matching Home Page Design System */
    .stat-card-clean {
        background: linear-gradient(-45deg, 
            rgba(16, 42, 67, var(--card-opacity)) 0%, 
            rgba(11, 31, 51, var(--card-opacity)) 65%, 
            rgba(122, 31, 43, var(--card-opacity)) 90%, 
            rgba(16, 42, 67, var(--card-opacity)) 100%);
        background-size: 300% 300%;
        animation: gradientMove 12s ease-in-out infinite;
        border-radius: var(--cc-radius-lg, 14px);
        box-shadow: 0 8px 24px rgba(16, 42, 67, 0.15);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, border-color 0.3s ease;
        color: #ffffff;
        border: 1px solid rgba(255,255,255,0.12);
        position: relative;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-left: 5px solid var(--cc-gold-light, #E5D28A);
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
        min-width: 140px;
        max-width: 260px;
    }

    .stat-card-clean:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 28px rgba(122, 31, 43, 0.3) !important; 
        border-color: rgba(255,255,255,0.35);
    }

    .stat-title {
        font-family: var(--font-body, 'Inter', sans-serif);
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: center;
        font-weight: 700;
    }

    .stat-value {
        font-family: var(--font-body, 'Inter', sans-serif);
        color: #ffffff;
        font-size: 0.98rem; 
        font-weight: 800;
        margin-top: 4px;
        line-height: 1.2;
        text-align: center;
    }

    /* Division Filter Tabs matching Home Page */
    .division-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        background: linear-gradient(135deg, rgba(241, 245, 249, 0.9) 0%, rgba(226, 232, 240, 0.9) 100%);
        border: 1px solid rgba(16, 42, 67, 0.15); 
        color: var(--cc-primary, #102A43);
        font-family: var(--font-body, 'Inter', sans-serif);
        font-weight: 700;
        text-transform: uppercase;
        padding: 7px 18px;
        font-size: 0.8rem;
        border-radius: 50px;
        transition: var(--cc-transition, all 0.25s ease);
        box-shadow: 0 2px 6px rgba(16, 42, 67, 0.04);
        backdrop-filter: blur(4px);
    }

    .filter-btn:hover { 
        background: linear-gradient(135deg, rgba(226, 232, 240, 1) 0%, rgba(203, 213, 225, 1) 100%);
        color: var(--cc-primary-dark, #0B1F33); 
    }

    .filter-btn.active-filter { 
        background: linear-gradient(135deg, var(--cc-primary, #102A43) 0%, var(--cc-secondary, #7A1F2B) 100%);
        background-size: 200% 100%;
        border-color: rgba(255,255,255,0.2); 
        color: var(--cc-white, #FFFFFF); 
        box-shadow: 0 4px 12px rgba(122, 31, 43, 0.25); 
    }

    /* Minimalist Rankings Table Layout */
    .minimalist-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
        background: white;
        table-layout: fixed;
    }
    
    /* Table Headers now share the animated gradient card styles */
    .minimalist-table th {
        font-family: var(--font-body, 'Inter', sans-serif);
        background: linear-gradient(-45deg, 
            rgba(16, 42, 67, var(--card-opacity)) 0%, 
            rgba(11, 31, 51, var(--card-opacity)) 65%, 
            rgba(122, 31, 43, var(--card-opacity)) 90%, 
            rgba(16, 42, 67, var(--card-opacity)) 100%);
        background-size: 300% 300%;
        animation: gradientMove 12s ease-in-out infinite;
        color: #ffffff;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 12px 8px;
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
        letter-spacing: 0.3px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .minimalist-table td {
        padding: 0.85rem 8px;
        vertical-align: middle;
        border-bottom: 1px solid #dee2e6;
        font-family: var(--font-body, 'Inter', sans-serif);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Dynamic Alternating Zebra Contrast with Theme Tint */
    .minimalist-table tbody tr {
        background-color: #ffffff;
    }

    .minimalist-table tbody tr:nth-child(even) {
        background-color: rgba(122, 31, 43, 0.03); /* Slight burgundy/navy theme tint for rows */
    }

    .minimalist-table tbody tr:hover {
        background-color: rgba(16, 42, 67, 0.06) !important;
    }

    /* Blue Glow Shadow Effect for Table Container */
    .table-shadow-blue {
        border: 1px solid rgba(16, 42, 67, 0.15) !important;
        box-shadow: 0 10px 30px rgba(16, 42, 67, 0.08) !important;
        border-radius: var(--cc-radius-lg, 14px);
        overflow: hidden;
    }

    /* Medal Text Colors */
    .medal-text-gold { color: var(--cc-gold, #C9A227); font-weight: 800; }
    .medal-text-silver { color: #64748B; font-weight: 800; }
    .medal-text-bronze { color: #C2410C; font-weight: 800; }

    /* Solid White Sidebar Container Card */
    .updates-sidebar-card {
        background: #ffffff !important;
        border: 1px solid rgba(16, 42, 67, 0.12) !important;
        box-shadow: 0 8px 24px rgba(16, 42, 67, 0.08) !important;
        border-top: 4px solid var(--cc-gold, #C9A227) !important;
        border-radius: var(--cc-radius-lg, 14px);
        color: var(--cc-text, #17202A) !important;
        padding: 1.5rem;
        height: 100%;
    }

    /* Gradient Feed Item Cards that Pop-up on White Background */
    .feed-item {
        background: linear-gradient(-45deg, 
            rgba(16, 42, 67, var(--card-opacity)) 0%, 
            rgba(11, 31, 51, var(--card-opacity)) 65%, 
            rgba(122, 31, 43, var(--card-opacity)) 90%, 
            rgba(16, 42, 67, var(--card-opacity)) 100%);
        background-size: 300% 300%;
        animation: gradientMove 12s ease-in-out infinite;
        border-radius: var(--cc-radius-md, 10px);
        border-left: 5px solid var(--cc-gold, #C9A227) !important;
        padding: 1.15rem; 
        box-shadow: 0 6px 18px rgba(16, 42, 67, 0.18);
        margin-bottom: 1.15rem;
        color: #ffffff;
        border: 1px solid rgba(255,255,255,0.12);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, border-color 0.3s ease;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .feed-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 24px rgba(122, 31, 43, 0.3) !important; 
        border-color: rgba(255,255,255,0.35);
    }
    
    .feed-title { 
        font-family: var(--font-body, 'Inter', sans-serif); 
        color: #ffffff !important; 
        font-size: 0.9rem; 
        font-weight: 700;
        margin-bottom: 3px; 
    }

    .feed-time { 
        color: rgba(255,255,255,0.8) !important; 
        font-size: 0.7rem; 
        font-weight: 600; 
    }

    .feed-div { 
        font-size: 0.72rem; 
        color: var(--cc-gold-light, #E5D28A) !important; 
        font-weight: 700; 
        text-transform: uppercase;
        margin-bottom: 8px; 
        letter-spacing: 0.3px;
    }
    
    .medal-text { 
        font-size: 0.82rem; 
        color: #ffffff !important; 
        display: flex; 
        align-items: center; 
    }

    .medal-icon { 
        margin-right: 6px; 
        font-size: 0.95rem; 
    }

    /* Mobile View Responsive Layout Modifications */
    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 1.15rem !important;
            white-space: nowrap !important; 
            flex-wrap: nowrap !important; 
        }
        .page-header p {
            font-size: 0.80rem !important; 
        }

        .stat-value { font-size: 0.85rem; }
        .stat-title { font-size: 0.65rem; letter-spacing: 0px; }
        .stat-card-clean { padding: 0.75rem; border-left-width: 4px; max-width: 100%; }
        
        .minimalist-table th, .minimalist-table td {
            padding: 10px 4px !important;
            font-size: 0.78rem !important;
        }
        .school-name-text {
            font-size: 0.82rem !important;
        }
    }

    @@media (max-width: 576px) {
        .division-filters {
            justify-content: flex-start;
        }
        .filter-btn {
            text-align: center;
            font-size: 0.78rem;
        }
    }
</style>

<div class="container py-4 py-md-5">
    
    <!-- Header Section -->
    <div class="page-header d-flex justify-content-between align-items-end">
        <div>
            <h1 class="display-6 fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-trophy-fill text-warning"></i> OVERALL TEAM RANKINGS
            </h1>
            <p class="fs-6 text-muted mb-0" style="font-family: var(--font-body); font-weight: 600;">Sub-Congressional (LoCaTu) Meet Official Medal Standings</p>
        </div>
    </div>

    <div class="row g-4 align-items-stretch">
        
        <!-- Main Standings Board Section -->
        <div class="col-12 col-lg-8 d-flex flex-column">
            
            <!-- Dashboard Status Cards -->
            <div class="d-flex justify-content-center gap-2 gap-md-3 mb-4 w-100">
                <div class="stat-card-clean">
                    <div class="stat-title">Last Update</div>
                    <div class="stat-value">@lastUpdatedString</div>
                </div>
                <div class="stat-card-clean" style="border-left-color: var(--cc-gold, #C9A227);">
                    <div class="stat-title">Events Done</div>
                    <div class="stat-value">@eventsRecorded <span class="fw-normal opacity-75" style="font-size: 0.85em;">/ @totalEvents Games</span></div>
                </div>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0 fw-bold" style="font-family: var(--font-body); color: var(--cc-primary);">Leaderboard</h4>
            </div>

            <!-- Division & Overall Selection Tabs -->
            <div class="division-filters">
                <button class="filter-btn active-filter" onclick="setDivisionFilter('Secondary', this)">Secondary</button>
                <button class="filter-btn" onclick="setDivisionFilter('Elementary', this)">Elementary</button>
                <button class="filter-btn" onclick="setDivisionFilter('Overall', this)">Overall</button>
            </div>

            <div class="flex-grow-1 p-0 bg-transparent border-0 shadow-none">
                @if(!Model.Any())
                {
                    <div class="text-center py-5 bg-white rounded shadow-sm">
                        <i class="bi bi-trophy" style="font-size: 3rem; color: var(--cc-text-muted);"></i>
                        <p class="mt-3 text-muted fw-bold">No recorded entries yet. The games have not started.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive bg-white rounded table-shadow-blue p-0 p-md-0">
                        <table class="minimalist-table w-100 mb-0" id="rankingsTable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 14%;">Rank</th>
                                    <th style="width: 32%;">Area</th>
                                    <th class="text-center" style="width: 13%;">🥇 G</th>
                                    <th class="text-center" style="width: 13%;">🥈 S</th>
                                    <th class="text-center" style="width: 13%;">🥉 B</th>
                                    <th class="text-center" style="width: 15%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Secondary & Elementary Rows -->
                                @foreach (var tally in sortedStandings)
                                {
                                    int totalMedals = tally.Gold + tally.Silver + tally.Bronze;
                                    string fullTeamName = tally.Team?.Name ?? "Unknown Team";
                                    string displaySchoolName = !string.IsNullOrEmpty(tally.Team?.Acronym) ? tally.Team.Acronym : fullTeamName;
                                    string teamColor = GetHouseText(fullTeamName);
                                    string rowDivision = tally.Team?.Division ?? "Secondary";

                                    <tr class="ranking-row" data-division="@rowDivision" data-gold="@tally.Gold" data-silver="@tally.Silver" data-bronze="@tally.Bronze">
                                        <td class="text-center fw-bold rank-cell" style="color: var(--cc-primary); font-size: 1rem;"></td>
                                        <td>
                                            <span class="fw-bold school-name-text" data-default-color="@teamColor" style="color: @teamColor; font-size: 0.95rem;">
                                                @displaySchoolName
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold medal-text-gold">@tally.Gold</td>
                                        <td class="text-center fw-bold medal-text-silver">@tally.Silver</td>
                                        <td class="text-center fw-bold medal-text-bronze">@tally.Bronze</td>
                                        <td class="text-center fw-bold" style="color: var(--cc-primary); font-size: 0.95rem;">@totalMedals</td>
                                    </tr>
                                }

                                <!-- Overall Combined Municipality Rows -->
                                @foreach (var overall in overallStandings)
                                {
                                    int totalMedals = overall.Total;
                                    string teamColor = GetHouseText(overall.Municipality);

                                    <tr class="ranking-row" data-division="Overall" data-gold="@overall.Gold" data-silver="@overall.Silver" data-bronze="@overall.Bronze" style="display: none;">
                                        <td class="text-center fw-bold rank-cell" style="color: var(--cc-primary); font-size: 1rem;"></td>
                                        <td>
                                            <span class="fw-bold school-name-text" data-default-color="@teamColor" style="color: @teamColor; font-size: 0.95rem;">
                                                @overall.Municipality
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold medal-text-gold">@overall.Gold</td>
                                        <td class="text-center fw-bold medal-text-silver">@overall.Silver</td>
                                        <td class="text-center fw-bold medal-text-bronze">@overall.Bronze</td>
                                        <td class="text-center fw-bold" style="color: var(--cc-primary); font-size: 0.95rem;">@totalMedals</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <div id="noRankingsRow" class="text-center py-5 bg-white mt-0" style="display: none;">
                            <p class="mb-0 text-muted fw-bold">No ranking statistics recorded for this category yet.</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Updates Feed Section (Solid White Background Container) -->
        <div class="col-12 col-lg-4">
            <div class="updates-sidebar-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 fw-bold" style="font-family: var(--font-body); color: var(--cc-primary);">Recent Updates</h4>
                    <span class="badge bg-light text-primary border rounded-pill px-2 py-1" style="font-size: 0.7rem; font-weight: 700;">Latest Results</span>
                </div>
                
                <div style="max-height: 550px; overflow-y: auto; padding-right: 5px;">
                    @if (!recentResults.Any())
                    {
                        <div class="text-center py-4 text-muted border border-dashed rounded bg-light">
                            <small>Awaiting news from ongoing match events...</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var game in recentResults)
                        {
                            <div class="feed-item">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="feed-title mb-0">@game.Title</h6>
                                    <small class="feed-time">@FormatToPst(game.UpdatedAt, "h:mm tt")</small>
                                </div>
                                <div class="feed-div">@(game.Division ?? "Secondary")</div>
                                
                                <div class="d-flex flex-column gap-1">
                                    @if(game.GoldTeamId.HasValue && teamNames.ContainsKey(game.GoldTeamId.Value))
                                    {
                                        string goldIdentifier = GetTeamDisplayName(game.GoldTeamId.Value);
                                        <div class="medal-text"><span class="medal-icon">🥇</span> <span class="fw-bold">@goldIdentifier</span><span class="ms-1 opacity-75" style="font-size: 0.75rem;">(Gold)</span></div>
                                    }
                                    @if(game.SilverTeamId.HasValue && teamNames.ContainsKey(game.SilverTeamId.Value))
                                    {
                                        string silverIdentifier = GetTeamDisplayName(game.SilverTeamId.Value);
                                        <div class="medal-text"><span class="medal-icon">🥈</span> <span class="fw-bold">@silverIdentifier</span><span class="ms-1 opacity-75" style="font-size: 0.75rem;">(Silver)</span></div>
                                    }
                                    @if(game.BronzeTeamId.HasValue && teamNames.ContainsKey(game.BronzeTeamId.Value))
                                    {
                                        string bronzeIdentifier = GetTeamDisplayName(game.BronzeTeamId.Value);
                                        <div class="medal-text"><span class="medal-icon">🥉</span> <span class="fw-bold">@bronzeIdentifier</span><span class="ms-1 opacity-75" style="font-size: 0.75rem;">(Bronze)</span></div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const divisionsList = ['Secondary', 'Elementary', 'Overall'];
    let currentDivIndex = 0;
    let autoTimer = null;
    let idleTimer = null;
    let isAutoRotating = true;

    $(document).ready(function() {
        let savedDivision = 'Secondary';
        try {
            const stored = sessionStorage.getItem('subcong_rankings_division');
            if (stored && divisionsList.includes(stored)) savedDivision = stored;
        } catch (e) {}

        // Initialize state
        currentDivIndex = divisionsList.indexOf(savedDivision);
        updateActiveButton(savedDivision);
        applyDivisionFilter(savedDivision);
        
        // Start automatic rotation immediately on page load
        startAutoRotation();

        // Listen for user interactions anywhere on the page to reset the 20-second idle timer
        $(document).on('mousemove keypress touchstart', function() {
            if (!isAutoRotating) {
                resetIdleTimer();
            }
        });
    });

    function updateActiveButton(division) {
        $('.division-filters .filter-btn').removeClass('active-filter');
        $('.division-filters .filter-btn').each(function() {
            if ($(this).text().trim().toLowerCase() === division.toLowerCase()) {
                $(this).addClass('active-filter');
            }
        });
    }

    // Called when a user clicks one of the leaderboard buttons
    function setDivisionFilter(division, btnElement) {
        isAutoRotating = false;
        clearInterval(autoTimer); // Stop auto-rotation immediately
        
        currentDivIndex = divisionsList.findIndex(d => d.toLowerCase() === division.toLowerCase());
        
        updateActiveButton(division);
        
        try {
            sessionStorage.setItem('subcong_rankings_division', division);
        } catch (e) {}
        
        applyDivisionFilter(division);
        
        // Start the 10-second idle timer waiting for no movement
        resetIdleTimer();
    }

    // Core function to rotate the tables every 10 seconds
    function startAutoRotation() {
        isAutoRotating = true;
        clearInterval(autoTimer);
        autoTimer = setInterval(function() {
            currentDivIndex = (currentDivIndex + 1) % divisionsList.length;
            let nextDiv = divisionsList[currentDivIndex];
            
            updateActiveButton(nextDiv);
            applyDivisionFilter(nextDiv);
        }, 10000);
    }

    // Controls the 15-second timeout. If it finishes without being reset by movement, it auto-rotates again.
    function resetIdleTimer() {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(function() {
            startAutoRotation();
        }, 15000); 
    }

    // Core table display logic (unchanged from original processing)
    function applyDivisionFilter(division) {
        let visibleCount = 0;
        let runningCount = 1;
        let displayRank = 1;
        
        let prevGold = -1;
        let prevSilver = -1;
        let prevBronze = -1;

        $('.ranking-row').each(function() {
            let rowDivision = $(this).data('division') ? $(this).data('division').toString().trim().toLowerCase() : '';
            let targetDivision = division.toString().trim().toLowerCase();

            if (rowDivision === targetDivision) {
                $(this).show();
                
                let gold = parseInt($(this).data('gold')) || 0;
                let silver = parseInt($(this).data('silver')) || 0;
                let bronze = parseInt($(this).data('bronze')) || 0;

                if (gold === prevGold && silver === prevSilver && bronze === prevBronze) {
                    // Tie scenario encountered - displayRank remains the same
                } else {
                    displayRank = runningCount;
                }

                $(this).find('.rank-cell').text(displayRank);

                let nameElement = $(this).find('.school-name-text');
                let defaultColor = nameElement.data('default-color');
                
                if (displayRank === 1) {
                    nameElement.css('color', '#D4AF37'); 
                } else if (displayRank === 2) {
                    nameElement.css('color', '#64748B'); 
                } else if (displayRank === 3) {
                    nameElement.css('color', '#C2410C'); 
                } else {
                    nameElement.css('color', defaultColor); 
                }

                prevGold = gold;
                prevSilver = silver;
                prevBronze = bronze;
                
                runningCount++;
                visibleCount++;
            } else {
                $(this).hide();
            }
        });

        // Dynamic Striping Fix for Visibility Shifts matching theme tint
        $('.ranking-row:visible').each(function(index) {
            $(this).css('background-color', (index % 2 === 1) ? 'rgba(122, 31, 43, 0.03)' : '#ffffff');
        });

        if (visibleCount === 0) {
            $('#noRankingsRow').show();
            $('#rankingsTable').hide();
        } else {
            $('#noRankingsRow').hide();
            $('#rankingsTable').show();
        }
    }
</script>
}