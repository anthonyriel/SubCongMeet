<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sub-Congressional Meet 2026</title>
    
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" type="image/x-icon" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Updated to Inter for modern, highly readable typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SubcongMeet.styles.css" asp-append-version="true" />
    
    <style>
        /* ========================================== */
        /* CONGRESSIONAL CLASSIC - DESIGN SYSTEM      */
        /* ========================================== */
        :root { 
            /* Color Palette */
            --cc-primary: #102A43;
            --cc-primary-dark: #0B1F33;
            --cc-secondary: #7A1F2B;
            --cc-secondary-dark: #5E1721;
            --cc-gold: #C9A227;
            --cc-gold-light: #E5D28A;
            
            --cc-white: #FFFFFF;
            --cc-background: #F7F8FA;
            
            --cc-text: #17202A;
            --cc-text-secondary: #667085;
            --cc-text-muted: #98A2B3;
            --cc-border: #D9DEE5;

            /* Utility Colors */
            --cc-success: #16803C;
            --cc-warning: #B7791F;
            --cc-danger: #C53030;
            --cc-info: #245B8F;

            /* Modern UI Variables */
            --cc-radius-sm: 6px;
            --cc-radius-md: 10px;
            --cc-radius-lg: 14px;
            
            --cc-shadow-sm: 0 2px 6px rgba(16, 42, 67, 0.04);
            --cc-shadow-md: 0 8px 24px rgba(16, 42, 67, 0.06);
            --cc-shadow-hover: 0 8px 20px rgba(16, 42, 67, 0.10), 0 16px 32px rgba(16, 42, 67, 0.06);
            
            --cc-transition: all 0.25s ease;

            /* Base Font overrides */
            --font-body: 'Inter', Segoe UI, Arial, sans-serif;
            --bs-body-font-family: var(--font-body); 
            color-scheme: light;
        }

        /* OVERRIDE ASP.NET DEFAULT MARGINS & SETUP BACKGROUND */
        html, body {
            margin: 0 !important; 
            padding: 0 !important;
            height: 100%;
        }

        body { 
            background-color: var(--cc-background); 
            font-family: var(--font-body); 
            color: var(--cc-text); 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            -webkit-font-smoothing: antialiased;
        }

        /* Typography */
        h1, h2, h3, h4, h5, h6, .brand-title { 
            font-family: var(--font-body) !important; 
            font-weight: 700;
        }

        .offcanvas-title {
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
        }

        /* Animated Gradient Keyframes */
        @@keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Navbar - Animated Navy-to-Burgundy Gradient with Glassmorphism */
        .navbar-custom { 
            background: linear-gradient(-45deg, 
                rgba(16, 42, 67, 0.92) 0%, 
                rgba(11, 31, 51, 0.92) 40%, 
                rgba(122, 31, 43, 0.92) 80%, 
                rgba(16, 42, 67, 0.92) 100%) !important; 
            background-size: 300% 300% !important;
            animation: gradientMove 12s ease-in-out infinite !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 3px solid var(--cc-gold) !important; /* Gold Accent matching Hero Banner */
            box-shadow: var(--cc-shadow-md); 
            transition: var(--cc-transition);
        }

        /* PURE PNG LOGO STYLING */
        .navbar-logo { 
            height: 48px; 
            width: auto; 
            background-color: transparent !important;
            border: none !important;
            padding: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            object-fit: contain;
            transition: transform var(--cc-transition);
        }

        .navbar-brand:hover .navbar-logo {
            transform: scale(1.02);
        }

        .brand-title { 
            color: var(--cc-white); 
            font-size: clamp(1.1rem, 2.5vw, 1.35rem); 
            letter-spacing: 1px; 
            font-weight: 800;
            margin-bottom: 0; 
            line-height: 1.1; 
            text-transform: uppercase;
        }

        .brand-subtitle { 
            color: var(--cc-gold-light); 
            font-size: 0.75rem; 
            letter-spacing: 1.5px; 
            font-weight: 600;
            text-transform: uppercase;
        }

        /* Offcanvas Drawer - Clean Light Surface */
        .offcanvas-custom { 
            background-color: var(--cc-white); 
            border-left: 1px solid var(--cc-border); 
            box-shadow: -8px 0 32px rgba(16, 42, 67, 0.12); 
            max-width: 320px; 
            border-top-left-radius: var(--cc-radius-lg);
            border-bottom-left-radius: var(--cc-radius-lg);
        }

        /* ULTRA SMOOTH OFFCANVAS TRANSITION */
        .offcanvas {
            transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
        }

        .offcanvas-header {
            border-bottom: 1px solid var(--cc-border);
            padding: 1.25rem 1.5rem;
        }

        .drawer-section-title { 
            color: var(--cc-text-muted); 
            font-size: 0.75rem; 
            letter-spacing: 1.5px; 
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 0.75rem; 
            margin-top: 2rem; 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            padding-left: 0.5rem;
        }
        
        /* Navigation Links - Maroon Default, Dark Navy Hover */
        .drawer-link { 
            display: flex; 
            align-items: center; 
            justify-content: space-between; 
            padding: 10px 14px; 
            color: var(--cc-secondary); /* Maroon Default */
            text-decoration: none; 
            border-radius: var(--cc-radius-md); 
            margin-bottom: 4px; 
            font-weight: 600;
            font-size: 0.95rem; 
            transition: var(--cc-transition); 
            border: 1px solid transparent;
        }

        .drawer-link:hover, .drawer-link:focus-visible { 
            background-color: var(--cc-background); 
            color: var(--cc-primary-dark); /* Dark Navy Hover */
            border-color: var(--cc-border);
            transform: translateX(4px); 
        }

        .drawer-link .icon-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .drawer-link i { 
            color: var(--cc-secondary); /* Maroon Default */
            font-size: 1.15rem; 
            transition: color var(--cc-transition);
        }

        .drawer-link:hover i {
            color: var(--cc-primary-dark); /* Dark Navy Hover */
        }

        .drawer-link .chevron { 
            color: var(--cc-secondary); /* Maroon Default */
            font-size: 0.8rem;
            transition: transform var(--cc-transition), color var(--cc-transition);
        }
        
        .drawer-link:hover .chevron {
            color: var(--cc-primary-dark); /* Dark Navy Hover */
        }

        /* Click Expandable Dropdown styling inside Drawer */
        .drawer-dropdown-container {
            position: relative;
        }

        .drawer-submenu {
            display: none;
            padding-left: 2.5rem;
            list-style: none;
            margin: 0 0 8px 0;
            animation: fadeInSubmenu 0.3s ease forwards;
        }

        @@keyframes fadeInSubmenu {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .drawer-dropdown-container.show-submenu .drawer-submenu {
            display: block;
        }

        .drawer-dropdown-container.show-submenu > .drawer-link .chevron {
            transform: rotate(90deg);
            color: var(--cc-primary-dark);
        }
        
        .drawer-dropdown-container.show-submenu > .drawer-link,
        .drawer-dropdown-container.show-submenu > .drawer-link i {
            color: var(--cc-primary-dark);
        }

        .drawer-sub-link {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            color: var(--cc-secondary); /* Maroon Default */
            text-decoration: none;
            border-radius: var(--cc-radius-md);
            font-size: 0.85rem;
            font-weight: 500;
            transition: var(--cc-transition);
        }

        .drawer-sub-link:hover {
            background-color: var(--cc-background);
            color: var(--cc-primary-dark); /* Dark Navy Hover */
            transform: translateX(4px);
        }

        .drawer-sub-link i {
            color: var(--cc-secondary); /* Maroon Default */
            transition: color var(--cc-transition);
        }
        
        .drawer-sub-link:hover i {
            color: var(--cc-primary-dark) !important; /* Dark Navy Hover */
        }

        /* Footer - Clean, Structured */
        .footer-custom { 
            background-color: var(--cc-white); 
            padding: 1.2rem 0; 
            border-top: 1px solid var(--cc-border); 
            margin-top: auto;
            box-shadow: 0 -4px 15px rgba(16, 42, 67, 0.02); 
        }

        .footer-text { 
            margin: 0 !important; 
            font-weight: 500; 
            color: var(--cc-text-secondary); 
            font-size: 0.85rem; 
        }

        /* Respect Reduced Motion */
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

        /* ========================================== */
        /* MOBILE RESPONSIVENESS FIX FOR HEADER       */
        /* ========================================== */
        @@media (max-width: 575.98px) {
            .navbar-logo {
                height: 38px;
            }
            .brand-subtitle {
                font-size: 0.65rem;
                letter-spacing: 1px;
            }
            .navbar-brand.gap-3 {
                gap: 0.75rem !important; 
            }
            .navbar-brand .gap-2 {
                gap: 0.25rem !important; 
            }
            .offcanvas-custom {
                border-top-left-radius: 0;
                border-bottom-left-radius: 0;
                max-width: 85vw; /* Adaptive drawer width */
            }
            .navbar-toggler i {
                font-size: 1.75rem !important;
            }
        }
    </style>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-custom">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <div class="d-flex gap-2">
                        <img src="~/images/deped_logo.png" alt="DepEd Logo" class="navbar-logo" />
                        <img src="~/images/bohol_logo.png" alt="Bohol Logo" class="navbar-logo" />
                    </div>
                    <div class="d-flex flex-column">
                        <span class="brand-subtitle">Division of Bohol</span>
                        <span class="brand-title">LOCATU</span>
                    </div>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu">
                    <i class="bi bi-list" style="font-size: 2rem; color: var(--cc-white);"></i>
                </button>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-end offcanvas-custom" tabindex="-1" id="offcanvasMenu">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title d-flex align-items-center" style="color: var(--cc-primary);">
                <i class="bi bi-grid-fill me-3" style="font-size: 1.5rem; color: var(--cc-secondary);"></i> Menu
            </h5>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        
        <div class="offcanvas-body px-3 py-4">
            <a asp-controller="Home" asp-action="Index" class="drawer-link">
                <div class="icon-container"><i class="bi bi-house-door-fill"></i> Home</div>
                <i class="bi bi-chevron-right chevron"></i>
            </a>
            <a asp-controller="Rankings" asp-action="Index" class="drawer-link">
                <div class="icon-container"><i class="bi bi-trophy-fill"></i> Rankings</div>
                <i class="bi bi-chevron-right chevron"></i>
            </a>
            <a asp-controller="Events" asp-action="Index" class="drawer-link">
                <div class="icon-container"><i class="bi bi-calendar-event-fill"></i> Events</div>
                <i class="bi bi-chevron-right chevron"></i>
            </a>
            <a asp-controller="Teams" asp-action="Dashboard" class="drawer-link">
                <div class="icon-container"><i class="bi bi-people-fill"></i> Areas</div>
                <i class="bi bi-chevron-right chevron"></i>
            </a>

            <div class="drawer-section-title"><i class="bi bi-shield-lock-fill me-2" style="color: var(--cc-text-muted);"></i> Account</div>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="px-3 mb-3 pb-2 border-bottom small text-muted">
                    Logged in as:<br/>
                    <strong style="color: var(--cc-primary); font-size: 1rem;">@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</strong>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Coordinators" asp-action="Index" class="drawer-link">
                        <div class="icon-container"><i class="bi bi-person-badge-fill"></i> Coordinators</div>
                        <i class="bi bi-chevron-right chevron"></i>
                    </a>
                    <a asp-controller="Events" asp-action="ManageEvents" class="drawer-link">
                        <div class="icon-container"><i class="bi bi-sliders"></i> Manage Events</div>
                        <i class="bi bi-chevron-right chevron"></i>
                    </a>
                    
                    <!-- Click Expandable Official Reports Menu -->
                    <div class="drawer-dropdown-container">
                        <a href="javascript:void(0);" class="drawer-link" onclick="this.parentElement.classList.toggle('show-submenu')">
                            <div class="icon-container"><i class="bi bi-file-earmark-bar-graph-fill"></i> Official Reports</div>
                            <i class="bi bi-chevron-right chevron"></i>
                        </a>
                        <ul class="drawer-submenu">
                            <li>
                                <a asp-controller="Home" asp-action="GeneralOfficialReport" class="drawer-sub-link">
                                    <i class="bi bi-bar-chart-line-fill me-2"></i> General Official Report
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="AllEventsResultsReport" class="drawer-sub-link">
                                    <i class="bi bi-list-check me-2"></i> All Events Results Report
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="DistrictQualifierReport" class="drawer-sub-link">
                                    <i class="bi bi-award-fill me-2"></i> District Qualifier Report
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 mt-3">
                    <button type="submit" class="drawer-link w-100 bg-transparent text-start">
                        <div class="icon-container"><i class="bi bi-box-arrow-right"></i> Sign Out</div>
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="drawer-link mt-2">
                    <div class="icon-container"><i class="bi bi-box-arrow-in-right"></i> Login</div>
                    <i class="bi bi-chevron-right chevron"></i>
                </a>
            }
        </div>
    </div>
    
    <div class="container-fluid px-0 flex-grow-1">
        <main role="main">@RenderBody()</main>
    </div>

    <footer class="footer-custom text-center">
        <div class="container px-3">
            <p class="footer-text">&copy; 2026 Anthony Riel C. Diango CpE, LPT</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>