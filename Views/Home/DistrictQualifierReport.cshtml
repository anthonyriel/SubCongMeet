@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.RegularExpressions
@inject SubcongMeet.Data.ApplicationDbContext DbContext
@model IEnumerable<SubcongMeet.Models.EventQualifier>
@{
    ViewData["Title"] = "District Qualifier Report";
    
    var allDbEvents = DbContext.Events.ToList();
    var selectedSports = (Context.Request.Query["sportsName"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var selectedEvents = (Context.Request.Query["eventId"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var selectedDivisions = (Context.Request.Query["division"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
    var selectedSchools = (Context.Request.Query["schoolName"].ToString() ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    // Helper lambda to determine division
    string GetEventDivision(SubcongMeet.Models.Event evt) {
        if (evt == null) return "";
        string div = "";
        var prop = evt.GetType().GetProperty("Division");
        if (prop != null) {
            div = (prop.GetValue(evt) as string)?.ToUpper() ?? "";
        } else if (evt.Title != null) {
            if (evt.Title.IndexOf("ELEM", StringComparison.OrdinalIgnoreCase) >= 0) div = "ELEMENTARY";
            else if (evt.Title.IndexOf("SEC", StringComparison.OrdinalIgnoreCase) >= 0) div = "SECONDARY";
        }
        return div;
    }

    // Helper method to convert names to Proper Case (Title Case)
    string ToProperCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;
        var textInfo = new System.Globalization.CultureInfo("en-US", false).TextInfo;
        return textInfo.ToTitleCase(text.ToLower());
    }

    // Sort qualifiers by Division -> Sports -> Event Title -> Event Category -> Role -> Name
    var reportQualifiers = Model?
        .OrderBy(q => {
            // 1. Sort by Division (Elementary then Secondary)
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            string div = evt != null ? GetEventDivision(evt) : "";
            if (div.Contains("ELEM")) return 1;
            if (div.Contains("SEC")) return 2;
            return 3;
        })
        .ThenBy(q => {
            // 2. Sort by Sports
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            return evt?.SportName ?? "";
        })
        .ThenBy(q => {
            // 3. Sort by Event Title
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            return evt?.Title ?? "";
        })
        .ThenBy(q => {
            // 4. Sort by Event Category (Girls, Boys, Mixed)
            var evt = allDbEvents.FirstOrDefault(e => e.Id == q.EventId);
            string title = evt?.Title?.ToLower() ?? "";
            if (title.Contains("girls")) return 1;
            if (title.Contains("boys")) return 2;
            if (title.Contains("mixed")) return 3;
            return 4;
        })
        .ThenBy(q => {
            // 5. Sort by Roles (Athletes -> Chaperone -> Assistant Coach -> Coach)
            string r = q.Role?.ToLower() ?? "";
            if (r.Contains("athlete")) return 1;
            if (r.Contains("chaperon")) return 2; // Catches chaperone as well
            if (r.Contains("assistant coach")) return 3;
            if (r.Contains("coach")) return 4;
            return 5;
        })
        .ThenBy(q => q.ParticipantName) // 6. Sort by Name
        .ToList() ?? new List<SubcongMeet.Models.EventQualifier>();

    SubcongMeet.Models.Event? GetEvent(long eventId)
    {
        return allDbEvents.FirstOrDefault(e => e.Id == eventId);
    }

    var globalTshirtSizes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var q in reportQualifiers)
    {
        string pName = q.ParticipantName?.Trim() ?? "";
        string sName = q.SchoolName?.Trim() ?? "";
        string tSize = q.TshirtSize?.Trim() ?? "";
        
        if (!string.IsNullOrEmpty(pName) && !string.IsNullOrEmpty(tSize) && !tSize.Equals("N/A", StringComparison.OrdinalIgnoreCase))
        {
            string key = $"{pName}_{sName}";
            if (!globalTshirtSizes.ContainsKey(key))
            {
                globalTshirtSizes[key] = tSize;
            }
        }
    }

    int uniqueQualifiersCount = reportQualifiers
        .Where(q => !string.IsNullOrWhiteSpace(q.ParticipantName))
        .Select(q => $"{q.ParticipantName?.Trim().ToLower()}_{q.SchoolName?.Trim().ToLower()}")
        .Distinct()
        .Count();

    bool groupEvents = selectedDivisions.Count == 0 || selectedDivisions.Count > 1;

    // ==========================================
    // LOGIC FOR DISTRICT QUALIFIER REPORT
    // ==========================================
    string lastRenderedSport = "";
    string lastRenderedEvent = "";
    HashSet<string> seenParticipantsForTshirt = new HashSet<string>();

    void ResetTracker()
    {
        lastRenderedSport = "";
        lastRenderedEvent = "";
    }

    void RenderQualifierRow(SubcongMeet.Models.EventQualifier qualifier)
    {
        var evt = GetEvent(qualifier.EventId);
        string sportName = evt?.SportName ?? "N/A";
        string eventTitle = evt?.Title ?? "N/A";
        string div = evt != null ? GetEventDivision(evt) : "";
        
        string roleDisplay = !string.IsNullOrEmpty(qualifier.Role) 
            ? char.ToUpper(qualifier.Role.First()) + qualifier.Role.Substring(1).ToLower() 
            : "N/A";

        string displaySport = sportName == lastRenderedSport ? "" : sportName;
        string displayEvent = eventTitle == lastRenderedEvent ? "" : eventTitle;

        lastRenderedSport = sportName;
        lastRenderedEvent = eventTitle;

        string pNameKey = qualifier.ParticipantName?.Trim() ?? "";
        string sNameKey = qualifier.SchoolName?.Trim() ?? "";
        string globalKey = $"{pNameKey}_{sNameKey}";
        string bestTshirtSize = globalTshirtSizes.ContainsKey(globalKey) ? globalTshirtSizes[globalKey] : "N/A";

        string globalParticipantKey = $"{qualifier.ParticipantName?.Trim().ToLower()}_{qualifier.SchoolName?.Trim().ToLower()}";
        bool isDuplicateTshirt = !seenParticipantsForTshirt.Add(globalParticipantKey);

        string tShirtDisplay = isDuplicateTshirt ? "-" : bestTshirtSize;

        <tr>
            <td class="text-start">
                @if (!string.IsNullOrEmpty(displaySport)) { <strong>@displaySport</strong> }
            </td>
            <td class="text-start"><div class="event-title-clamp">@displayEvent</div></td>
            <td class="text-start" style="white-space: nowrap;"><strong>@(string.IsNullOrEmpty(qualifier.ParticipantName) ? "N/A" : ToProperCase(qualifier.ParticipantName))</strong></td>
            <td class="text-start" style="white-space: nowrap;">@(string.IsNullOrEmpty(qualifier.SchoolName) ? "N/A" : qualifier.SchoolName)</td>
            <td class="text-start">@roleDisplay</td>
            <td class="text-center">@tShirtDisplay</td>
        </tr>
    }

    // ==========================================
    // LOGIC FOR PARTICIPANT LIST
    // ==========================================
    string lastRenderedSport_PL = "";
    HashSet<string> seenParticipantsForList = new HashSet<string>();
    HashSet<string> seenParticipantsForTshirt_PL = new HashSet<string>();

    void ResetTracker_PL()
    {
        lastRenderedSport_PL = "";
        seenParticipantsForList.Clear();
    }

    void RenderParticipantRow(SubcongMeet.Models.EventQualifier qualifier)
    {
        var evt = GetEvent(qualifier.EventId);
        string sportName = evt?.SportName ?? "N/A";
        string div = evt != null ? GetEventDivision(evt) : "";
        
        string eventParticipantKey = $"{div}_{sportName}_{qualifier.ParticipantName?.Trim().ToLower()}_{qualifier.SchoolName?.Trim().ToLower()}_{qualifier.Role?.Trim().ToLower()}";
        if (!seenParticipantsForList.Add(eventParticipantKey)) return; 

        string roleDisplay = !string.IsNullOrEmpty(qualifier.Role) 
            ? char.ToUpper(qualifier.Role.First()) + qualifier.Role.Substring(1).ToLower() 
            : "N/A";

        string displaySport = sportName == lastRenderedSport_PL ? "" : sportName;
        lastRenderedSport_PL = sportName;

        string pNameKey = qualifier.ParticipantName?.Trim() ?? "";
        string sNameKey = qualifier.SchoolName?.Trim() ?? "";
        string globalKey = $"{pNameKey}_{sNameKey}";
        string bestTshirtSize = globalTshirtSizes.ContainsKey(globalKey) ? globalTshirtSizes[globalKey] : "N/A";

        string globalParticipantKey = $"{qualifier.ParticipantName?.Trim().ToLower()}_{qualifier.SchoolName?.Trim().ToLower()}";
        bool isDuplicateTshirt = !seenParticipantsForTshirt_PL.Add(globalParticipantKey);
        string tShirtDisplay = isDuplicateTshirt ? "-" : bestTshirtSize;

        <tr>
            <td class="text-start">
                @if (!string.IsNullOrEmpty(displaySport)) { <strong>@displaySport</strong> }
            </td>
            <td class="text-start" style="white-space: nowrap;"><strong>@(string.IsNullOrEmpty(qualifier.ParticipantName) ? "N/A" : ToProperCase(qualifier.ParticipantName))</strong></td>
            <td class="text-start" style="white-space: nowrap;">@(string.IsNullOrEmpty(qualifier.SchoolName) ? "N/A" : qualifier.SchoolName)</td>
            <td class="text-start">@roleDisplay</td>
            <td class="text-center">@tShirtDisplay</td>
        </tr>
    }
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .report-wrapper {
        background-color: #ffffff; 
        color: #000000; 
        font-family: Arial, Helvetica, sans-serif;
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 50px;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
    }
    
    .report-header-text { font-size: 0.9rem; margin-bottom: 3px; font-weight: 600; color: #000000; }
    .report-divider { border-top: 2px solid #000000; margin: 15px 0; width: 100%; }
    .report-title { font-size: 1.4rem; font-weight: 800; letter-spacing: 0.5px; color: #000000; }
    
    .meta-col { border-right: 1px solid #000000; }
    .meta-col:last-child { border-right: none; }
    .meta-label { font-size: 0.65rem; color: #000000; margin-bottom: 2px; font-weight: 700; letter-spacing: 0.5px; }
    .meta-value { font-size: 0.85rem; font-weight: bold; color: #000000; }
    
    .table-report { width: 100%; border-collapse: collapse; margin-bottom: 20px; background-color: #ffffff; border: 1px solid #000000; }
    
    .table-report th { padding: 8px 10px; text-align: center; font-size: 0.75rem; font-weight: bold; border-bottom: 2px solid #000000; color: #000000; background-color: #f2f2f2; }
    .table-report td { padding: 8px 10px; font-size: 0.75rem; border-bottom: 1px solid #cccccc; vertical-align: top; color: #000000; text-align: left; }
    .group-header { background-color: #e9ecef !important; color: #000000 !important; font-weight: bold !important; text-align: left !important; font-size: 0.85rem !important; border-top: 2px solid #000000 !important; border-bottom: 2px solid #000000 !important; }

    .event-title-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal; 
    }

    .cert-text { font-size: 0.85rem; line-height: 1.5; color: #000000; margin-bottom: 25px; text-align: justify; }
    
    .setup-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 51, 160, 0.15);
        border-top: 4px solid #0033A0;
        max-width: 1200px;
        margin: 0 auto 20px auto;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 51, 160, 0.08);
    }

    .dynamic-signatures-container { text-align: center; width: 100%; }
    .sig-block { display: inline-block; width: 48%; vertical-align: top; margin-top: 40px; text-align: center; page-break-inside: avoid !important; }
    .sig-block-odd { width: 100% !important; display: block; margin-left: auto; margin-right: auto; }
    .sig-title { font-size: 0.85rem; font-weight: bold; text-transform: uppercase; border-bottom: 1px solid #000000; padding-bottom: 2px; display: inline-block; min-width: 200px; }
    .sig-line { font-size: 0.75rem; margin-top: 2px; }

    @@page {
        size: A4 portrait;
        margin: 0.5in !important; 
    }

    @@media print {
        header, footer, nav, .d-print-none, #setup-section { display: none !important; }
        html, body, main { background-color: #ffffff !important; margin: 0 !important; padding: 0 !important; color: #000000 !important; width: 100% !important; height: auto !important; overflow: visible !important; }
        .container, .container-fluid, .pb-3, #report-section, #participant-section { width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 auto !important; }

        .report-wrapper {
            display: block !important; 
            position: static !important;
            width: 100% !important; 
            max-width: 100% !important;
            margin: 0 auto !important; 
            padding: 0 !important;
            box-shadow: none !important;
        }

        .report-divider { border-top: 2px solid #000000 !important; margin: 18px 0 !important; }
        .meta-col { border-right: 1px solid #cccccc !important; width: 50%; display: inline-block; vertical-align: top; }
        .meta-label { color: #000000 !important; font-size: 0.7rem !important; }
        .meta-value { color: #000000 !important; font-size: 0.9rem !important; }
        
        .table-report { border: 1px solid #000000 !important; margin-bottom: 25px !important; width: 100% !important; }
        .table-report thead { display: table-header-group; }
        .table-report tr { page-break-inside: avoid; }
        .table-report th { background-color: #f2f2f2 !important; color: #000000 !important; border-bottom: 2px solid #000000 !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .table-report td { color: #000000 !important; border-bottom: 1px solid #cccccc !important; }
        .group-header { background-color: #e9ecef !important; color: #000000 !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        
        .dynamic-signatures-container { text-align: center !important; width: 100% !important; }
        .sig-block { display: inline-block !important; width: 48% !important; vertical-align: top; page-break-inside: avoid !important; margin-top: 30px !important; text-align: center !important; }
        .sig-block-odd { width: 100% !important; display: block !important; margin-left: auto !important; margin-right: auto !important; }
        .sig-title { font-size: 0.85rem; font-weight: bold; text-transform: uppercase; border-bottom: 1px solid #000000; padding-bottom: 2px; display: inline-block; min-width: 200px; color: #000000 !important; }
        .sig-line { font-size: 0.75rem; margin-top: 2px; color: #000000 !important; }
        .row::after { content: ""; clear: both; display: table; }
    }
</style>

<div class="container py-4">

    <!-- STEP 1: CONFIGURATION SETUP -->
    <div id="setup-section" class="card setup-card p-4 mb-4 d-print-none">
        <h4 class="fw-bold mb-3 border-bottom pb-2" style="color: #0033A0;">
            Configure Qualifier Filters
        </h4>
        
        <div class="mb-4 bg-light p-3 rounded border">
            <form method="get" asp-action="DistrictQualifierReport" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Filter by Sports</label>
                        <select name="sportsName" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Sports --">
                            @if (ViewBag.SportsList != null)
                            {
                                foreach (var sport in ViewBag.SportsList)
                                {
                                    if (selectedSports.Contains(sport.Value)) { <option value="@sport.Value" selected>@sport.Text</option> }
                                    else { <option value="@sport.Value">@sport.Text</option> }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Filter by Event</label>
                        <select name="eventId" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Events --">
                            @if (ViewBag.EventsList != null)
                            {
                                foreach (var evt in ViewBag.EventsList)
                                {
                                    if (selectedEvents.Contains(evt.Value)) { <option value="@evt.Value" selected>@evt.Text</option> }
                                    else { <option value="@evt.Value">@evt.Text</option> }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Filter by Division</label>
                        <select name="division" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Divisions --">
                            @if (ViewBag.DivisionsList != null)
                            {
                                foreach (var div in ViewBag.DivisionsList)
                                {
                                    if (selectedDivisions.Contains(div.Value)) { <option value="@div.Value" selected>@div.Text</option> }
                                    else { <option value="@div.Value">@div.Text</option> }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Filter by School Name</label>
                        <select name="schoolName" class="form-select select2-multi" multiple="multiple" data-placeholder="-- All Schools --">
                            @if (ViewBag.SchoolNamesList != null)
                            {
                                foreach (var sch in ViewBag.SchoolNamesList)
                                {
                                    if (selectedSchools.Contains(sch.Value)) { <option value="@sch.Value" selected>@sch.Text</option> }
                                    else { <option value="@sch.Value">@sch.Text</option> }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-12 text-end mt-3">
                        <button type="submit" class="btn text-white shadow-sm px-4 fw-bold" style="background-color: #0033A0;" onclick="saveSignatories();">Apply Filters</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Signatories Configuration -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold mb-0" style="color: #0033A0;">Signatories</label>
                <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addSignatory()">Add Signatory</button>
            </div>
            <div id="signatory-error" class="alert alert-danger py-2 px-3 mb-3 fw-bold" style="display: none;">Please enter at least one signatory.</div>
            <div id="signatories-container"></div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Cancel</a>
            <a asp-action="EditQualifiers" class="btn btn-outline-primary px-4 fw-bold">Edit Qualifiers</a>
            <button type="button" class="btn text-white px-4 fw-bold" style="background-color: #17a2b8;" onclick="generateReport('participant')">List of Participants</button>
            <button type="button" class="btn text-white px-4 fw-bold" style="background-color: #0033A0;" onclick="generateReport('qualifier')">Generate Report Preview</button>
        </div>
    </div>

    <!-- STEP 2A: REPORT PREVIEW / PRINT AREA (QUALIFIER REPORT) -->
    <div id="report-section" style="display: none;">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mb-4 mx-auto gap-3 d-print-none" style="max-width: 1000px;">
            <button onclick="backToSetup()" class="btn btn-outline-secondary btn-sm fw-bold">Back to Configuration</button>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn text-white shadow px-4 fw-bold" style="background-color: #0033A0;"><i class="bi bi-printer"></i> Print / Save PDF</button>
                <button onclick="generateExcel('qualifier')" class="btn btn-success shadow px-4 fw-bold"><i class="bi bi-file-earmark-excel"></i> Export Excel</button>
            </div>
        </div>

        <div class="report-wrapper">
            <div>
                <div class="text-center">
                    <div class="report-header-text">Republic of the Philippines</div>
                    <div class="report-header-text">Department of Education</div>
                    <div class="report-header-text">Division of Bohol</div>
                    <div class="report-header-text fs-5 mt-2 mb-1 fw-bold">CALAPE DISTRICT</div>
                    <div class="report-header-text" style="font-weight: normal;">Calape, Bohol</div>
                </div>

                <div class="report-divider"></div>

                <div class="text-center mb-3">
                    <div class="report-title mb-1">HIGHER MEET QUALIFIER 2026</div>
                </div>

                <div class="report-divider"></div>

                <div class="row text-center py-1">
                    <div class="col-6 meta-col">
                        <div class="meta-label">REPORT DATE</div>
                        <div class="meta-value">@DateTime.UtcNow.AddHours(8).ToString("MMMM dd, yyyy h:mm tt") PST</div>
                    </div>
                    <div class="col-6 meta-col">
                        <div class="meta-label">TOTAL QUALIFIERS</div>
                        <div class="meta-value">@(uniqueQualifiersCount) Participants</div>
                    </div>
                </div>

                <div class="report-divider"></div>

                <h5 class="fw-bold mb-3" style="font-size: 1.05rem; letter-spacing: 0.5px;">QUALIFIED PARTICIPANTS LIST</h5>
                <table class="table-report" id="resultsTable">
                    <thead>
                        <tr>
                            <th style="width: 14%;">Sports</th>
                            <th style="width: 25%;">Event Title</th>
                            <th style="width: 22%; white-space: nowrap;">Name</th>
                            <th style="width: 22%; white-space: nowrap;">Area/District</th>
                            <th style="width: 8%;">Role</th>
                            <th style="width: 9%;">T-Shirt Sizes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(!reportQualifiers.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4">No qualifier records available for the current filters.</td></tr>
                        }
                        else
                        {
                            if (groupEvents)
                            {
                                var elemQualifiers = reportQualifiers.Where(q => { var evt = GetEvent(q.EventId); return evt != null && GetEventDivision(evt).Contains("ELEM"); }).ToList();
                                var secQualifiers = reportQualifiers.Where(q => { var evt = GetEvent(q.EventId); return evt != null && GetEventDivision(evt).Contains("SEC"); }).ToList();
                                var otherQualifiers = reportQualifiers.Where(q => { var evt = GetEvent(q.EventId); return evt == null || (!GetEventDivision(evt).Contains("ELEM") && !GetEventDivision(evt).Contains("SEC")); }).ToList();

                                if (elemQualifiers.Any())
                                {
                                    ResetTracker(); 
                                    <tr><td colspan="6" class="group-header py-2">ELEMENTARY DIVISION</td></tr>
                                    foreach (var q in elemQualifiers) { RenderQualifierRow(q); }
                                }
                                if (secQualifiers.Any())
                                {
                                    ResetTracker(); 
                                    <tr><td colspan="6" class="group-header py-2">SECONDARY DIVISION</td></tr>
                                    foreach (var q in secQualifiers) { RenderQualifierRow(q); }
                                }
                                if (otherQualifiers.Any())
                                {
                                    ResetTracker(); 
                                    <tr><td colspan="6" class="group-header py-2">OTHER EVENTS</td></tr>
                                    foreach (var q in otherQualifiers) { RenderQualifierRow(q); }
                                }
                            }
                            else
                            {
                                ResetTracker();
                                foreach (var qualifier in reportQualifiers)
                                {
                                    RenderQualifierRow(qualifier);
                                }
                            }
                        }
                    </tbody>
                </table>

                <h5 class="fw-bold mb-2 mt-4" style="font-size: 1.05rem; letter-spacing: 0.5px;">CERTIFICATION</h5>
                <p class="cert-text">
                    This official report lists all confirmed athletes, coaches, and chaperones qualified for the higher meet, 
                    verified and recorded through the Calape District Meet Management System.
                </p>

                <div class="report-divider" style="margin-bottom: 25px;"></div>
                <div class="row dynamic-signatures-container" id="dynamic-signatures-qualifier"></div>
            </div>
        </div>
    </div>

    <!-- STEP 2B: REPORT PREVIEW / PRINT AREA (PARTICIPANT LIST) -->
    <div id="participant-section" style="display: none;">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mb-4 mx-auto gap-3 d-print-none" style="max-width: 1000px;">
            <button onclick="backToSetup()" class="btn btn-outline-secondary btn-sm fw-bold">Back to Configuration</button>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn text-white shadow px-4 fw-bold" style="background-color: #17a2b8;"><i class="bi bi-printer"></i> Print / Save PDF</button>
                <button onclick="generateExcel('participant')" class="btn btn-success shadow px-4 fw-bold"><i class="bi bi-file-earmark-excel"></i> Export Excel</button>
            </div>
        </div>

        <div class="report-wrapper">
            <div>
                <div class="text-center">
                    <div class="report-header-text">Republic of the Philippines</div>
                    <div class="report-header-text">Department of Education</div>
                    <div class="report-header-text">Division of Bohol</div>
                    <div class="report-header-text fs-5 mt-2 mb-1 fw-bold">CALAPE DISTRICT</div>
                    <div class="report-header-text" style="font-weight: normal;">Calape, Bohol</div>
                </div>

                <div class="report-divider"></div>

                <div class="text-center mb-3">
                    <div class="report-title mb-1">LIST OF PARTICIPANTS 2026</div>
                </div>

                <div class="report-divider"></div>

                <div class="row text-center py-1">
                    <div class="col-6 meta-col">
                        <div class="meta-label">REPORT DATE</div>
                        <div class="meta-value">@DateTime.UtcNow.AddHours(8).ToString("MMMM dd, yyyy h:mm tt") PST</div>
                    </div>
                    <div class="col-6 meta-col">
                        <div class="meta-label">TOTAL PARTICIPANTS</div>
                        <div class="meta-value">@(uniqueQualifiersCount) Participants</div>
                    </div>
                </div>

                <div class="report-divider"></div>

                <table class="table-report" id="participantTable">
                    <thead>
                        <tr>
                            <th style="width: 16%;">Sports</th>
                            <th style="width: 32%; white-space: nowrap;">Participant Name</th>
                            <th style="width: 32%; white-space: nowrap;">School Name</th>
                            <th style="width: 10%;">Role</th>
                            <th style="width: 10%;">T-Shirt Sizes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(!reportQualifiers.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4">No qualifier records available for the current filters.</td></tr>
                        }
                        else
                        {
                            if (groupEvents)
                            {
                                var elemQualifiers = reportQualifiers.Where(q => { var evt = GetEvent(q.EventId); return evt != null && GetEventDivision(evt).Contains("ELEM"); }).ToList();
                                var secQualifiers = reportQualifiers.Where(q => { var evt = GetEvent(q.EventId); return evt != null && GetEventDivision(evt).Contains("SEC"); }).ToList();
                                var otherQualifiers = reportQualifiers.Where(q => { var evt = GetEvent(q.EventId); return evt == null || (!GetEventDivision(evt).Contains("ELEM") && !GetEventDivision(evt).Contains("SEC")); }).ToList();

                                if (elemQualifiers.Any())
                                {
                                    ResetTracker_PL(); 
                                    <tr><td colspan="5" class="group-header py-2">ELEMENTARY DIVISION</td></tr>
                                    foreach (var q in elemQualifiers) { RenderParticipantRow(q); }
                                }
                                if (secQualifiers.Any())
                                {
                                    ResetTracker_PL(); 
                                    <tr><td colspan="5" class="group-header py-2">SECONDARY DIVISION</td></tr>
                                    foreach (var q in secQualifiers) { RenderParticipantRow(q); }
                                }
                                if (otherQualifiers.Any())
                                {
                                    ResetTracker_PL(); 
                                    <tr><td colspan="5" class="group-header py-2">OTHER EVENTS</td></tr>
                                    foreach (var q in otherQualifiers) { RenderParticipantRow(q); }
                                }
                            }
                            else
                            {
                                ResetTracker_PL();
                                foreach (var qualifier in reportQualifiers)
                                {
                                    RenderParticipantRow(qualifier);
                                }
                            }
                        }
                    </tbody>
                </table>

                <h5 class="fw-bold mb-2 mt-4" style="font-size: 1.05rem; letter-spacing: 0.5px;">CERTIFICATION</h5>
                <p class="cert-text">
                    This official report lists all confirmed athletes, coaches, and chaperones verified and recorded through the Calape District Meet Management System.
                </p>

                <div class="report-divider" style="margin-bottom: 25px;"></div>
                <div class="row dynamic-signatures-container" id="dynamic-signatures-participant"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        let activeSignatories = [];

        $(document).ready(function() {
            loadSignatories();
            $('.select2-multi').select2({ placeholder: '-- All --', allowClear: true, width: '100%', multiple: true });
        });

        function saveSignatories() {
            const dataToSave = [];
            document.querySelectorAll('.signatory-row').forEach(row => {
                dataToSave.push({ name: row.querySelector('.sig-name').value, designation: row.querySelector('.sig-designation').value });
            });
            sessionStorage.setItem('calape_qualifier_signatories', JSON.stringify(dataToSave));
        }

        function loadSignatories() {
            const stored = sessionStorage.getItem('calape_qualifier_signatories');
            const container = document.getElementById('signatories-container');
            container.innerHTML = ''; 
            if (stored) {
                const parsed = JSON.parse(stored);
                if (parsed.length > 0) {
                    parsed.forEach(s => addSignatoryRow(s.name, s.designation));
                    return;
                }
            }
            addSignatoryRow('', '');
        }

        function addSignatoryRow(name = '', desig = '') {
            const container = document.getElementById('signatories-container');
            const row = document.createElement('div');
            row.className = 'row mb-2 signatory-row';
            row.innerHTML = `
                <div class="col-sm-5"><input type="text" class="form-control sig-name" placeholder="Name" value="${name}" /></div>
                <div class="col-sm-6"><input type="text" class="form-control sig-designation" placeholder="Designation" value="${desig}" /></div>
                <div class="col-sm-1 text-end"><button type="button" class="btn btn-outline-danger btn-sm mt-1" onclick="this.closest('.signatory-row').remove()">X</button></div>
            `;
            container.appendChild(row);
        }

        function addSignatory() { addSignatoryRow('', ''); }

        function generateReport(type) {
            saveSignatories();
            const sigRows = document.querySelectorAll('.signatory-row');
            activeSignatories = [];
            sigRows.forEach(row => {
                const name = row.querySelector('.sig-name')?.value.trim() || '';
                const desig = row.querySelector('.sig-designation')?.value.trim() || '';
                if (name !== '' || desig !== '') {
                    activeSignatories.push({ name: name || '_________________________', designation: desig || '_________________________' });
                }
            });

            if (activeSignatories.length === 0) {
                document.getElementById('signatory-error').style.display = 'block';
                return;
            }
            document.getElementById('signatory-error').style.display = 'none';

            const sigContainer = type === 'qualifier' 
                ? document.getElementById('dynamic-signatures-qualifier') 
                : document.getElementById('dynamic-signatures-participant');
                
            sigContainer.innerHTML = ''; 
            
            activeSignatories.forEach((sig, index) => {
                const isLastOdd = (index === activeSignatories.length - 1) && (activeSignatories.length % 2 !== 0);
                
                const sigBlock = document.createElement('div');
                sigBlock.className = isLastOdd ? 'sig-block sig-block-odd' : 'sig-block';
                sigBlock.innerHTML = `<div class="sig-title">${sig.name}</div><div class="sig-line">${sig.designation}</div>`;
                sigContainer.appendChild(sigBlock);
            });

            document.getElementById('setup-section').style.display = 'none';
            if (type === 'qualifier') {
                document.getElementById('participant-section').style.display = 'none';
                document.getElementById('report-section').style.display = 'block';
            } else {
                document.getElementById('report-section').style.display = 'none';
                document.getElementById('participant-section').style.display = 'block';
            }
        }

        function backToSetup() {
            document.getElementById('report-section').style.display = 'none';
            document.getElementById('participant-section').style.display = 'none';
            document.getElementById('setup-section').style.display = 'block';
        }

        async function generateExcel(type) {
            const isQualifier = type === 'qualifier';
            const workbook = new ExcelJS.Workbook();
            
            const sheetName = isQualifier ? 'District Qualifiers' : 'Participant List';
            const worksheet = workbook.addWorksheet(sheetName, {
                pageSetup: { paperSize: 9, orientation: 'portrait', fitToPage: true, fitToWidth: 1, fitToHeight: 9999 }
            });

            const lastCol = isQualifier ? 'F' : 'E';

            if (isQualifier) {
                worksheet.columns = [{ width: 16 }, { width: 32 }, { width: 28 }, { width: 32 }, { width: 14 }, { width: 15 }];
            } else {
                worksheet.columns = [{ width: 20 }, { width: 38 }, { width: 38 }, { width: 14 }, { width: 15 }];
            }

            function addCenterText(text, size, bold) {
                const row = worksheet.addRow([text]);
                worksheet.mergeCells(`A${row.number}:${lastCol}${row.number}`);
                const cell = row.getCell(1);
                cell.alignment = { horizontal: 'center' };
                cell.font = { size: size, bold: bold };
            }

            addCenterText('Republic of the Philippines', 9, false);
            addCenterText('Department of Education', 9, false);
            addCenterText('Division of Bohol', 9, false);
            addCenterText('CALAPE DISTRICT MEET', 12, true);
            addCenterText('Calape, Bohol', 9, false);
            worksheet.addRow();

            const reportTitle = isQualifier ? 'DISTRICT QUALIFIER REPORT' : 'LIST OF PARTICIPANTS';
            addCenterText(reportTitle, 14, true);
            addCenterText('School Year 2026–2027', 11, true);
            worksheet.addRow();

            const labelRow = worksheet.addRow(['REPORT DATE', '', '', isQualifier ? 'TOTAL QUALIFIERS' : 'TOTAL PARTICIPANTS', '', '']);
            labelRow.font = { size: 8, bold: true };
            const valueRow = worksheet.addRow(['@DateTime.UtcNow.AddHours(8).ToString("MMMM dd, yyyy h:mm tt") PST', '', '', '@(uniqueQualifiersCount) Participants', '', '']);
            valueRow.font = { size: 10, bold: true };
            
            worksheet.mergeCells(`A${labelRow.number}:C${labelRow.number}`);
            worksheet.mergeCells(`A${valueRow.number}:C${valueRow.number}`);
            if (isQualifier) {
                worksheet.mergeCells(`D${labelRow.number}:F${labelRow.number}`);
                worksheet.mergeCells(`D${valueRow.number}:F${valueRow.number}`);
            } else {
                worksheet.mergeCells(`D${labelRow.number}:E${labelRow.number}`);
                worksheet.mergeCells(`D${valueRow.number}:E${valueRow.number}`);
            }
            worksheet.addRow();

            const tableHeaders = isQualifier 
                ? ['Sports', 'Event Title', 'Participant Name', 'School Name', 'Role', 'T-Shirt Sizes']
                : ['Sports', 'Participant Name', 'School Name', 'Role', 'T-Shirt Sizes'];
                
            const headerRow = worksheet.addRow(tableHeaders);
            headerRow.eachCell(cell => {
                cell.font = { bold: true };
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF2F2F2' } };
                cell.border = { bottom: { style: 'medium' }, top: { style: 'thin' }, left: { style: 'thin' }, right: { style: 'thin' } };
                cell.alignment = { horizontal: 'center', vertical: 'middle', wrapText: true };
            });

            const targetTable = isQualifier ? '#resultsTable tbody tr' : '#participantTable tbody tr';
            document.querySelectorAll(targetTable).forEach(tr => {
                const tds = tr.querySelectorAll('td');
                if (tds.length === 1) { 
                    const r = worksheet.addRow([tds[0].innerText.trim()]);
                    worksheet.mergeCells(`A${r.number}:${lastCol}${r.number}`);
                    const cell = r.getCell(1);
                    cell.alignment = { horizontal: 'left', vertical: 'middle' };
                    cell.font = { bold: true, size: 11 };
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE9ECEF' } };
                    cell.border = { bottom: { style: 'medium', color: { argb: 'FF000000' } }, top: { style: 'medium', color: { argb: 'FF000000' } } };
                } else {
                    const rowData = [];
                    tds.forEach(td => rowData.push(td.innerText.trim()));
                    const r = worksheet.addRow(rowData);
                    r.eachCell(cell => {
                        cell.alignment = { vertical: 'top', horizontal: 'left', wrapText: true };
                        cell.font = { bold: false };
                        cell.border = { bottom: { style: 'thin', color: { argb: 'FFCCCCCC' } } };
                    });
                }
            });

            worksheet.addRow();
            worksheet.addRow();

            const certTitle = worksheet.addRow(['CERTIFICATION']);
            certTitle.font = { bold: true, size: 11 };
            
            const certBody = isQualifier 
                ? 'This official report lists all confirmed athletes, coaches, and chaperones qualified for the higher meet, verified and recorded through the Calape District Meet Management System.'
                : 'This official report lists all confirmed athletes, coaches, and chaperones verified and recorded through the Calape District Meet Management System.';
                
            const certText = worksheet.addRow([certBody]);
            worksheet.mergeCells(`A${certText.number}:${lastCol}${certText.number}`);
            certText.getCell(1).alignment = { wrapText: true, horizontal: 'left', vertical: 'top' };
            certText.getCell(1).font = { bold: false };
            worksheet.getRow(certText.number).height = 35;

            worksheet.addRow();
            worksheet.addRow();

            if (activeSignatories.length > 0) {
                for (let i = 0; i < activeSignatories.length; i += 2) {
                    const sigRow = worksheet.addRow([]);
                    const titleRow = worksheet.addRow([]);
                    
                    sigRow.getCell(1).value = activeSignatories[i].name;
                    sigRow.getCell(1).font = { bold: true };
                    sigRow.getCell(1).alignment = { horizontal: 'center' };
                    
                    titleRow.getCell(1).value = activeSignatories[i].designation;
                    titleRow.getCell(1).alignment = { horizontal: 'center' };
                    titleRow.getCell(1).font = { bold: false };
                    
                    if (i === activeSignatories.length - 1 && activeSignatories.length % 2 !== 0) {
                        worksheet.mergeCells(`A${sigRow.number}:${lastCol}${sigRow.number}`);
                        worksheet.mergeCells(`A${titleRow.number}:${lastCol}${titleRow.number}`);
                    } else {
                        if (isQualifier) {
                            worksheet.mergeCells(`A${sigRow.number}:C${sigRow.number}`);
                            worksheet.mergeCells(`A${titleRow.number}:C${titleRow.number}`);
                        } else {
                            worksheet.mergeCells(`A${sigRow.number}:B${sigRow.number}`);
                            worksheet.mergeCells(`A${titleRow.number}:B${titleRow.number}`);
                        }
                    }

                    if (i + 1 < activeSignatories.length) {
                        const rightIndex = 4;
                        
                        sigRow.getCell(rightIndex).value = activeSignatories[i+1].name;
                        sigRow.getCell(rightIndex).font = { bold: true };
                        sigRow.getCell(rightIndex).alignment = { horizontal: 'center' };
                        
                        titleRow.getCell(rightIndex).value = activeSignatories[i+1].designation;
                        titleRow.getCell(rightIndex).alignment = { horizontal: 'center' };
                        titleRow.getCell(rightIndex).font = { bold: false };
                        
                        if (isQualifier) {
                            worksheet.mergeCells(`D${sigRow.number}:F${sigRow.number}`);
                            worksheet.mergeCells(`D${titleRow.number}:F${titleRow.number}`);
                        } else {
                            worksheet.mergeCells(`D${sigRow.number}:E${sigRow.number}`);
                            worksheet.mergeCells(`D${titleRow.number}:E${titleRow.number}`);
                        }
                    }
                    
                    worksheet.addRow();
                    worksheet.addRow();
                }
            }

            const buffer = await workbook.xlsx.writeBuffer();
            const fileName = isQualifier ? 'CalapeDistrict_Qualifier_Report.xlsx' : 'CalapeDistrict_Participant_List.xlsx';
            saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), fileName);
        }
    </script>
}