@model IEnumerable<SubcongMeet.Models.MedalTally>
@{
    ViewData["Title"] = "General Official Report";
}

<style>
    /* ==========================================
       CSS VARIABLES FOR THEME
       ========================================== */
    :root {
        --theme-navy: #002060;
        --theme-gold: #d4af37;
        --theme-gold-dark: #b8942e;
        --theme-maroon: #800000;
        --theme-text: #001540;
        --font-serif: "Times New Roman", Times, serif;
        --font-sans: "Arial", sans-serif;
    }

    /* ==========================================
       SCREEN VIEW STYLING & SETUP CARD
       ========================================== */
    .setup-card { 
        background-color: #ffffff; 
        border: 1px solid rgba(0, 32, 96, 0.15); 
        border-top: 4px solid var(--theme-navy);
        border-radius: 12px;
        color: #212529; 
        max-width: 800px; 
        margin: 0 auto; 
        box-shadow: 0 8px 25px rgba(0, 32, 96, 0.08);
    }

    .setup-input { 
        background-color: #ffffff; 
        color: #212529; 
        border: 1px solid #ced4da; 
    }

    .setup-input:focus { 
        border-color: var(--theme-navy); 
        outline: 0; 
        box-shadow: 0 0 0 0.25rem rgba(0, 32, 96, 0.25); 
    }

    /* ==========================================
       REPORT PREVIEW & PRINT STYLING
       ========================================== */
    .report-wrapper {
        background-color: #ffffff;
        color: var(--theme-text);
        font-family: var(--font-sans);
        max-width: 950px; 
        margin: 0 auto;
        padding: 10px 20px;
        position: relative;
    }
    
    .report-header-text { 
        font-size: 0.85rem; 
        margin-bottom: 2px; 
        font-weight: 700; 
        color: var(--theme-navy);
        font-family: var(--font-serif);
        letter-spacing: 0.5px;
    }

    /* Main Title Banner */
    .title-banner-wrapper {
        background-color: var(--theme-gold);
        padding: 3px;
        margin: 10px 0;
        clip-path: polygon(3% 0, 97% 0, 100% 50%, 97% 100%, 3% 100%, 0% 50%);
    }

    .title-banner-inner {
        background-color: var(--theme-navy);
        color: var(--theme-gold);
        text-align: center;
        padding: 6px 15px;
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        clip-path: polygon(3% 0, 97% 0, 100% 50%, 97% 100%, 3% 100%, 0% 50%);
    }

    /* Date and Time Line */
    .meta-container {
        border-top: 2px solid var(--theme-gold);
        border-bottom: 2px solid var(--theme-gold);
        margin: 5px 40px 28px 40px; /* Increased bottom margin for vertical space above tables */
        padding: 4px 0;
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .meta-label { 
        font-family: var(--font-sans);
        font-size: 0.75rem; 
        color: var(--theme-navy); 
        font-weight: 700; 
        letter-spacing: 1px; 
        margin-right: 10px;
    }

    .meta-value { 
        font-size: 0.8rem; 
        font-weight: 700; 
        color: var(--theme-navy); 
        border-bottom: 1px solid var(--theme-navy);
        padding: 0 15px;
    }

    /* Grid for Tables */
    .tables-section {
        display: flex;
        flex-direction: column;
        gap: 15px; 
    }

    .print-row-split {
        display: flex;
        justify-content: center;
        gap: 6%; 
        width: 100%;
    }

    .table-container-half {
        width: 38%; 
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    /* Maroon Section Tabs */
    .section-tab-wrapper {
        background-color: var(--theme-gold);
        padding: 2px 2px 0 2px;
        clip-path: polygon(10% 0, 90% 0, 100% 100%, 0% 100%);
        width: 70%;
        margin-bottom: -1px; 
        position: relative;
        z-index: 2;
    }

    .section-tab-inner {
        background-color: var(--theme-maroon);
        color: #ffffff;
        text-align: center;
        padding: 3px 10px;
        font-family: var(--font-serif);
        font-size: 0.85rem;
        font-weight: bold;
        letter-spacing: 1px;
        clip-path: polygon(10% 0, 90% 0, 100% 100%, 0% 100%);
    }

    /* Tables */
    .table-report { 
        width: 100%; 
        border-collapse: collapse; 
        background-color: #ffffff; 
        border: 2px solid var(--theme-gold-dark);
        z-index: 1;
    }

    .table-report th { 
        background-color: var(--theme-navy);
        color: var(--theme-gold);
        border: 1px solid var(--theme-gold-dark);
        padding: 4px 4px; 
        text-align: center; 
        font-size: 0.68rem; 
        font-weight: bold; 
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-family: var(--font-sans);
    }

    .table-report td { 
        padding: 3px 4px; 
        font-size: 0.72rem; 
        border: 1px solid var(--theme-gold-dark);
        font-weight: 600;
        color: var(--theme-navy);
    }
    
    .table-report td.text-left { text-align: left; }
    .table-report th.text-left { text-align: left; }

    /* Footer & Signatures */
    .footer-section {
        margin-top: 35px; /* Added spacing between Tables and Certification */
        font-family: var(--font-sans);
        padding: 0 20px;
    }

    .cert-title {
        font-size: 0.75rem;
        font-weight: bold;
        color: var(--theme-navy);
        margin-bottom: 2px;
        text-transform: uppercase;
    }

    .cert-text { 
        font-size: 0.7rem; 
        line-height: 1.3; 
        color: var(--theme-text); 
        margin-bottom: 40px; 
        text-align: justify;
    }
    
    .sig-block { 
        text-align: center; 
        padding-top: 10px; 
    }

    .sig-title { 
        font-size: 0.75rem; 
        font-weight: 700; 
        margin-bottom: 2px; 
        text-transform: uppercase; 
        color: var(--theme-navy);
        border-bottom: 1.5px solid var(--theme-navy);
        display: inline-block;
        min-width: 170px;
        padding-bottom: 2px;
    }

    .sig-line { 
        font-size: 0.65rem; 
        color: var(--theme-text); 
        margin-top: 2px; 
        font-weight: bold;
    }

    /* ==========================================
       NATIVE VECTOR PDF PRINT SPECIFICATIONS
       A4 Landscape: 0.5in Top/Bottom, 0.75in Left/Right
       ========================================== */
    @@page {
        size: A4 landscape;
        margin: 0.5in 0.75in;
    }

    @@media print {
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        header, footer, nav, .d-print-none, #setup-section {
            display: none !important;
        }

        body, html {
            background-color: #ffffff !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .container, .container-fluid, main {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #report-section, #pdf-content {
            display: block !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .report-wrapper {
            margin: 0 auto !important;
            padding: 0 !important;
            border: none !important; 
            outline: none !important;
            width: 100% !important;
            box-sizing: border-box !important;
            page-break-inside: avoid !important;
        }

        .meta-container {
            margin: 5px 40px 28px 40px !important;
        }
        
        .title-banner-inner { padding: 5px 10px !important; font-size: 1rem !important; }
        
        .tables-section { gap: 10px !important; }
        
        .print-row-split { 
            gap: 50px !important; 
            justify-content: center !important; 
        }

        .table-container-half {
            width: 38% !important; 
        }

        .table-report th { padding: 3px 2px !important; font-size: 0.65rem !important; }
        .table-report td { padding: 3px 2px !important; font-size: 0.68rem !important; }

        .footer-section { 
            margin-top: 35px !important; 
            padding: 0 !important; 
        }
        
        .cert-text { 
            font-size: 0.68rem !important; 
            margin-bottom: 45px !important; 
        }
        .sig-block { padding-top: 5px !important; page-break-inside: avoid !important; }
    }
</style>

<div class="container py-4">

    <!-- STEP 1: CONFIGURATION SETUP -->
    <div id="setup-section" class="card setup-card p-4 mb-4 d-print-none">
        <h4 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--theme-navy); font-family: var(--font-sans);">
            <i class="bi bi-gear-fill me-2"></i> Configure General Report
        </h4>
        
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold mb-0" style="color: var(--theme-navy);">Signatories</label>
                <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addSignatory()">
                    <i class="bi bi-plus-lg me-1"></i> Add Signatory
                </button>
            </div>

            <div id="signatory-error" class="alert alert-danger py-2 px-3 mb-3 fw-bold d-flex align-items-center" style="display: none;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Please enter at least one signatory (Name or Designation) before generating the report.
            </div>
            
            <div id="signatories-container">
                <div class="row mb-2 signatory-row">
                    <div class="col-sm-5">
                        <input type="text" class="form-control setup-input sig-name" placeholder="Name (e.g. Juan Dela Cruz)" />
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control setup-input sig-designation" placeholder="Designation (e.g. School Head)" />
                    </div>
                    <div class="col-sm-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm mt-1" title="Remove" onclick="this.closest('.signatory-row').remove()">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="row mb-2 signatory-row">
                    <div class="col-sm-5">
                        <input type="text" class="form-control setup-input sig-name" placeholder="Name" />
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control setup-input sig-designation" placeholder="Designation" />
                    </div>
                    <div class="col-sm-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm mt-1" title="Remove" onclick="this.closest('.signatory-row').remove()">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Cancel</a>
            <button type="button" class="btn text-white px-4 fw-bold" style="background-color: var(--theme-navy); border-color: var(--theme-navy);" onclick="generateReport()">
                <i class="bi bi-file-earmark-check me-1"></i> Generate Report
            </button>
        </div>
    </div>

    <!-- STEP 2: REPORT PREVIEW / PRINT AREA -->
    <div id="report-section" style="display: none;">
        
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mb-4 mx-auto gap-3 d-print-none" style="max-width: 950px;">
            <button onclick="backToSetup()" class="btn btn-outline-secondary btn-sm fw-bold align-self-start align-self-sm-center">
                <i class="bi bi-arrow-left me-1"></i> Edit Signatories
            </button>
            
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn text-white shadow px-4 fw-bold" style="background-color: var(--theme-navy); border-color: var(--theme-navy);">
                    <i class="bi bi-printer me-1"></i> Print / Export Vector PDF
                </button>
            </div>
        </div>

        <div id="pdf-content" class="report-wrapper">
            
            <!-- HEADER SECTION -->
            <div>
                <div class="text-center">
                    <div class="report-header-text">Republic of the Philippines</div>
                    <div class="report-header-text">Department of Education</div>
                    <div class="report-header-text">Division of Bohol</div>
                </div>

                <div class="title-banner-wrapper mx-auto" style="max-width: 80%;">
                    <div class="title-banner-inner">
                        LOCATU SUB-CONGRESSIONAL ATHLETIC MEET 2026 REPORT
                    </div>
                </div>

                <div class="meta-container">
                    <span class="meta-label">REPORT DATE & TIME: </span>
                    <span class="meta-value">@DateTime.Now.ToString("MMMM dd, yyyy • h:mm tt")</span>
                </div>
            </div>

            <!-- TABLES SECTION (2x2 GRID) -->
            <div class="tables-section">
                
                <!-- ROW 1: OVERALL & SECONDARY -->
                <div class="print-row-split">
                    <div class="table-container-half">
                        <div class="section-tab-wrapper">
                            <div class="section-tab-inner">OVERALL</div>
                        </div>
                        <table class="table-report" id="overall-table">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">Rank</th>
                                    <th class="text-left" style="width: 38%;">District</th>
                                    <th style="width: 12.5%;">Gold</th>
                                    <th style="width: 12.5%;">Silver</th>
                                    <th style="width: 12.5%;">Bronze</th>
                                    <th style="width: 12.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="overall-tbody"></tbody>
                        </table>
                    </div>

                    <div class="table-container-half">
                        <div class="section-tab-wrapper">
                            <div class="section-tab-inner">SECONDARY</div>
                        </div>
                        <table class="table-report" id="secondary-table">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">Rank</th>
                                    <th class="text-left" style="width: 38%;">District</th>
                                    <th style="width: 12.5%;">Gold</th>
                                    <th style="width: 12.5%;">Silver</th>
                                    <th style="width: 12.5%;">Bronze</th>
                                    <th style="width: 12.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="secondary-tbody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- ROW 2: ELEMENTARY & PARAGAMES -->
                <div class="print-row-split">
                    <div class="table-container-half">
                        <div class="section-tab-wrapper">
                            <div class="section-tab-inner">ELEMENTARY</div>
                        </div>
                        <table class="table-report" id="elementary-table">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">Rank</th>
                                    <th class="text-left" style="width: 38%;">District</th>
                                    <th style="width: 12.5%;">Gold</th>
                                    <th style="width: 12.5%;">Silver</th>
                                    <th style="width: 12.5%;">Bronze</th>
                                    <th style="width: 12.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="elementary-tbody"></tbody>
                        </table>
                    </div>

                    <div class="table-container-half">
                        <div class="section-tab-wrapper">
                            <div class="section-tab-inner">PARAGAMES</div>
                        </div>
                        <table class="table-report" id="paragames-table">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">Rank</th>
                                    <th class="text-left" style="width: 38%;">District</th>
                                    <th style="width: 12.5%;">Gold</th>
                                    <th style="width: 12.5%;">Silver</th>
                                    <th style="width: 12.5%;">Bronze</th>
                                    <th style="width: 12.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="paragames-tbody"></tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- FOOTER SECTION (CERTIFICATION & SIGNATORIES) -->
            <div class="footer-section">
                <div class="cert-title">CERTIFICATION</div>
                <p class="cert-text">
                    This report is generated from the official LoCaTu Sub-Congressional Meet Management System and reflects the 
                    standings recorded across all divisions at the time of generation. Any subsequent game results or medal updates may 
                    affect the rankings shown in this document.
                </p>

                <div class="row justify-content-center" id="dynamic-signatures"></div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rawTallies = [
            @if(Model != null)
            {
                foreach (var tally in Model)
                {
                    var teamName = tally.Team?.Name ?? "Unknown Team";
                    var teamDivision = tally.Team?.Division ?? "Elementary";
                    @: { name: @Json.Serialize(teamName), division: @Json.Serialize(teamDivision), gold: @tally.Gold, silver: @tally.Silver, bronze: @tally.Bronze },
                }
            }
        ];

        function addSignatory() {
            const container = document.getElementById('signatories-container');
            const row = document.createElement('div');
            row.className = 'row mb-2 signatory-row';
            row.innerHTML = `
                <div class="col-sm-5">
                    <input type="text" class="form-control setup-input sig-name" placeholder="Name" />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control setup-input sig-designation" placeholder="Designation" />
                </div>
                <div class="col-sm-1 text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm mt-1" title="Remove" onclick="this.closest('.signatory-row').remove()">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            container.appendChild(row);
        }

        function getRankedTallies(list) {
            const sorted = [...list].sort((a, b) => {
                if (b.gold !== a.gold) return b.gold - a.gold;
                if (b.silver !== a.silver) return b.silver - a.silver;
                if (b.bronze !== a.bronze) return b.bronze - a.bronze;
                return a.name.localeCompare(b.name);
            });

            let ranked = [];
            let runningCount = 1;
            let displayRank = 1;
            let prev = null;

            sorted.forEach((item) => {
                if (prev !== null && item.gold === prev.gold && item.silver === prev.silver && item.bronze === prev.bronze) {
                    // Retain rank for ties
                } else {
                    displayRank = runningCount;
                }
                ranked.push({ ...item, rank: displayRank });
                prev = item;
                runningCount++;
            });

            return ranked;
        }

        function renderTableRows(tbodyId, dataList) {
            const tbody = document.getElementById(tbodyId);
            tbody.innerHTML = '';

            const minRows = 4;

            if (dataList.length === 0) {
                for(let i=0; i<minRows; i++) {
                    tbody.innerHTML += `<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>`;
                }
                return;
            }

            dataList.forEach(item => {
                const total = item.gold + item.silver + item.bronze;
                const districtName = item.name.replace(/\bdistrict\b/ig, '').trim();

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center">${item.rank}</td>
                    <td class="text-left">${districtName}</td>
                    <td class="text-center">${item.gold}</td>
                    <td class="text-center">${item.silver}</td>
                    <td class="text-center">${item.bronze}</td>
                    <td class="text-center">${total}</td>
                `;
                tbody.appendChild(tr);
            });
            
            if (dataList.length < minRows) {
                for(let i=dataList.length; i<minRows; i++) {
                     tbody.innerHTML += `<tr><td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td></tr>`;
                }
            }
        }

        function generateReport() {
            const sigRows = document.querySelectorAll('.signatory-row');
            const validSignatories = [];
            const sigError = document.getElementById('signatory-error');

            sigRows.forEach(row => {
                const nameInput = row.querySelector('.sig-name');
                const designationInput = row.querySelector('.sig-designation');
                
                const name = nameInput ? nameInput.value.trim() : '';
                const designation = designationInput ? designationInput.value.trim() : '';
                
                if (name !== '' || designation !== '') {
                    validSignatories.push({
                        name: name || '_________________________',
                        designation: designation || '_________________________'
                    });
                }
            });

            if (validSignatories.length === 0) {
                if (sigError) sigError.style.display = 'flex';
                const firstInput = document.querySelector('.sig-name');
                if (firstInput) firstInput.focus();
                return; 
            }

            if (sigError) sigError.style.display = 'none';

            const secondaryList = rawTallies.filter(t => (t.division || '').toLowerCase() === 'secondary');
            const elementaryList = rawTallies.filter(t => (t.division || '').toLowerCase() === 'elementary');
            
            const overallMap = {};
            [...secondaryList, ...elementaryList].forEach(t => {
                const key = t.name.trim().toLowerCase();
                if (!overallMap[key]) {
                    overallMap[key] = { name: t.name, gold: 0, silver: 0, bronze: 0 };
                }
                overallMap[key].gold += t.gold;
                overallMap[key].silver += t.silver;
                overallMap[key].bronze += t.bronze;
            });
            const overallList = Object.values(overallMap);
            
            renderTableRows('overall-tbody', getRankedTallies(overallList));
            renderTableRows('secondary-tbody', getRankedTallies(secondaryList));
            renderTableRows('elementary-tbody', getRankedTallies(elementaryList));

            const paragamesList = rawTallies.filter(t => (t.division || '').toLowerCase() === 'paragames');
            renderTableRows('paragames-tbody', getRankedTallies(paragamesList));

            const sigContainer = document.getElementById('dynamic-signatures');
            sigContainer.innerHTML = ''; 

            validSignatories.forEach(sig => {
                const sigBlock = document.createElement('div');
                sigBlock.className = 'col sig-block';
                sigBlock.innerHTML = `
                    <div class="sig-title">${sig.name}</div>
                    <div class="sig-line">${sig.designation}</div>
                `;
                sigContainer.appendChild(sigBlock);
            });

            document.getElementById('setup-section').style.display = 'none';
            document.getElementById('report-section').style.display = 'block';
        }

        function backToSetup() {
            document.getElementById('report-section').style.display = 'none';
            document.getElementById('setup-section').style.display = 'block';
        }
    </script>
}