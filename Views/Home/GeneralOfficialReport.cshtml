@model IEnumerable<SubcongMeet.Models.MedalTally>
@{
    ViewData["Title"] = "General Official Report";
}

<style>
    /* ==========================================
       SCREEN & PRINT VIEW STYLING (DepEd Blue Light Theme)
       ========================================== */
    .report-wrapper {
        background-color: #ffffff;
        color: var(--text-main, #212529);
        font-family: var(--font-body, 'Inter', sans-serif);
        max-width: 1150px; 
        margin: 0 auto;
        padding: 25px 40px;
        border-radius: 12px;
        border-top: 6px solid var(--deped-blue, #0033A0);
        box-shadow: 0 10px 30px rgba(0, 51, 160, 0.1);
        display: flex;
        flex-direction: column;
        position: relative;
    }
    
    .report-header-text { 
        font-size: 0.85rem; 
        margin-bottom: 2px; 
        font-weight: 600; 
        color: #495057;
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .report-divider { 
        border-top: 2px solid rgba(0, 51, 160, 0.15); 
        margin: 10px 0; 
        width: 100%; 
    }

    .report-title { 
        font-family: var(--font-header, 'Montserrat', sans-serif);
        font-size: 1.2rem; 
        font-weight: 900; 
        letter-spacing: 0.5px; 
        color: var(--deped-blue, #0033A0);
    }
    
    .meta-container {
        background-color: rgba(0, 51, 160, 0.03);
        border: 1px solid rgba(0, 51, 160, 0.12);
        border-radius: 6px;
        padding: 6px 0;
        margin-bottom: 15px; /* Space after Date & Time before tables */
    }

    .meta-label { 
        font-family: var(--font-header, 'Montserrat', sans-serif);
        font-size: 0.7rem; 
        color: var(--deped-blue, #0033A0); 
        margin-bottom: 1px; 
        font-weight: 700; 
        letter-spacing: 0.5px; 
    }

    .meta-value { 
        font-size: 0.85rem; 
        font-weight: 700; 
        color: #212529; 
    }

    /* Balanced Layout Structure with Centered Tables & Compressed Width */
    .tables-section {
        display: flex;
        flex-direction: column;
        gap: 12px; /* Space between rows of tables */
        margin-bottom: 15px;
    }

    .print-row-split {
        display: flex;
        justify-content: center; /* Centered side-by-side */
        gap: 24px; /* Controlled gap between secondary and elementary tables */
        width: 100%;
    }

    .print-row-center {
        display: flex;
        justify-content: center; /* Centered overall table */
        width: 100%;
        margin-top: 4px;
    }

    .table-container-half {
        width: 42%; /* Compressed width for a cleaner, balanced look */
        max-width: 450px;
    }
    
    .table-report { 
        width: 100%; 
        border-collapse: collapse; 
        background-color: #ffffff; 
        border: 1px solid rgba(0, 51, 160, 0.18);
        border-radius: 6px; 
        overflow: hidden;
    }

    .table-report th { 
        font-family: var(--font-header, 'Montserrat', sans-serif);
        background: linear-gradient(135deg, #0056b3 0%, #0033A0 100%);
        color: #ffffff;
        padding: 8px 10px; 
        text-align: left; 
        font-size: 0.75rem; 
        font-weight: 700; 
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-report td { 
        padding: 8px 10px; 
        font-size: 0.82rem; 
        border-bottom: 1px solid #dee2e6; 
        font-weight: 500;
        color: #212529;
    }

    .table-report tbody tr:nth-child(even) {
        background-color: rgba(0, 51, 160, 0.03);
    }

    .table-report th.text-center, .table-report td.text-center { 
        text-align: center; 
    }

    .section-title {
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        color: var(--deped-blue, #0033A0);
        font-family: var(--font-header, 'Montserrat', sans-serif);
        margin-bottom: 6px;
    }
    
    .footer-section {
        margin-top: 12px; /* Space before Certification */
    }

    .cert-text { 
        font-size: 0.8rem; 
        line-height: 1.45; 
        color: #495057; 
        margin-bottom: 20px; /* Space before Signatures */
        text-align: justify;
    }
    
    .sig-block { 
        text-align: center; 
        padding-top: 22px; /* Extra space above signature names for physical signing */
    }

    .sig-title { 
        font-size: 0.82rem; 
        font-weight: 700; 
        margin-bottom: 3px; 
        text-transform: uppercase; 
        color: #212529;
        border-bottom: 1.5px solid #212529;
        display: inline-block;
        min-width: 180px;
        padding-bottom: 2px;
    }

    .sig-line { 
        font-size: 0.72rem; 
        color: #6c757d; 
        margin-top: 2px; 
        font-weight: 500;
    }

    /* ==========================================
       SETUP CONFIGURATION STYLES (Screen only)
       ========================================== */
    .setup-card { 
        background-color: #ffffff; 
        border: 1px solid rgba(0, 51, 160, 0.15); 
        border-top: 4px solid var(--deped-blue, #0033A0);
        border-radius: 12px;
        color: #212529; 
        max-width: 800px; 
        margin: 0 auto; 
        box-shadow: 0 8px 25px rgba(0, 51, 160, 0.08);
    }

    .setup-input { 
        background-color: #ffffff; 
        color: #212529; 
        border: 1px solid #ced4da; 
    }

    .setup-input:focus { 
        background-color: #ffffff; 
        color: #212529; 
        border-color: var(--deped-blue, #0033A0); 
        outline: 0; 
        box-shadow: 0 0 0 0.25rem rgba(0, 51, 160, 0.25); 
    }

    /* Medal Text Colors */
    .medal-gold { color: #b8860b; font-weight: 700; }
    .medal-silver { color: #6c757d; font-weight: 700; }
    .medal-bronze { color: #a05a2c; font-weight: 700; }

    /* ==========================================
       STRICT PRINT & NATIVE PDF LAYOUT 
       (A4 Landscape, Single-Page Balanced Auto-Fit with 0.5in Margins)
       ========================================== */
    @@page {
        size: A4 landscape;
        margin: 0.5in; 
    }

    @@media print {
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        header, footer, nav, .d-print-none, #setup-section {
            display: none !important;
        }

        body, html {
            background-color: #ffffff !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: 100% !important;
            overflow: hidden !important;
        }

        .container, .container-fluid, main {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #report-section, #pdf-content {
            display: block !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .report-wrapper {
            margin: 0 auto !important;
            padding: 6px 10px !important;
            box-shadow: none !important; 
            border: 1px solid rgba(0, 51, 160, 0.15) !important;
            border-top: 5px solid #0033A0 !important;
            border-radius: 6px !important;
            width: 100% !important;
            height: 100% !important;
            page-break-inside: avoid !important;
            page-break-after: avoid !important;
        }

        .tables-section {
            display: flex !important;
            flex-direction: column !important;
            gap: 30px !important; /* Adjust this to change vertical distance between table rows */
            margin: 8px 0 !important;
        }

        .print-row-split {
            display: flex !important;
            flex-direction: row !important;
            justify-content: center !important;
            gap: 30px !important; /* Adjust this to move them closer or further apart horizontally */
            width: 100% !important;
        }
        
        .print-row-center {
            display: flex !important;
            flex-direction: row !important;
            justify-content: center !important;
            width: 100% !important;
        }

        .table-container-half {
            width: 42% !important;
            max-width: 440px !important;
        }

        .report-divider { border-top: 1.2px solid #0033A0 !important; margin: 5px 0 !important; }
        
        .meta-container { 
            background-color: #f8f9fa !important; 
            border: 1px solid #0033A0 !important; 
            padding: 3px 0 !important;
            margin-bottom: 20px !important; /* Adjust this to change space below the date */
        }
        
        .meta-label { color: #0033A0 !important; font-size: 0.62rem !important; }
        .meta-value { color: #000000 !important; font-size: 0.75rem !important; }
        
        .report-header-text { font-size: 0.75rem !important; color: #000000 !important; margin-bottom: 1px !important; }
        .report-title { font-size: 1.05rem !important; color: #0033A0 !important; font-weight: bold !important; margin-bottom: 1px !important; }

        .table-report { 
            margin-bottom: 0 !important;
            border-radius: 0 !important;
            page-break-inside: avoid;
        }

        .table-report th { 
            background: #0033A0 !important; 
            color: #ffffff !important; 
            border-bottom: 1.5px solid #002277 !important; 
            padding: 4px 6px !important; /* Adjust padding for header row height */
            font-size: 0.68rem !important;
        }

        .table-report td { 
            color: #000000 !important; 
            border-bottom: 1px solid #cccccc !important; 
            padding: 4px 6px !important; /* Adjust first value (4px) to make data rows taller or shorter */
            font-size: 0.72rem !important;
        }
        
        .footer-section {
            margin-top: 8px !important; /* Space above certification title */
        }

        .cert-text { 
            color: #111111 !important; 
            font-size: 0.7rem !important; 
            line-height: 1.3 !important;
            margin-bottom: 10px !important; /* Space between certification text and signature blocks */
        }

        .sig-block {
            margin-top: 4px !important;
            padding-top: 18px !important; /* Proper spacing for manual signing */
            page-break-inside: avoid !important;
        }

        .sig-title { 
            color: #000000 !important; 
            border-bottom: 1px solid #000000 !important;
            font-size: 0.72rem !important; 
            font-weight: bold !important;
        }
        .sig-line { color: #333333 !important; font-size: 0.65rem !important; }
    }
</style>

<div class="container py-4">

    <!-- ==========================================
         STEP 1: CONFIGURATION SETUP (d-print-none)
         ========================================== -->
    <div id="setup-section" class="card setup-card p-4 mb-4 d-print-none">
        <h4 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--deped-blue, #0033A0); font-family: var(--font-header, 'Montserrat', sans-serif);">
            <i class="bi bi-gear-fill me-2"></i> Configure General Report
        </h4>
        
        <!-- Signatories Configuration -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold mb-0" style="color: var(--deped-blue, #0033A0);">Signatories</label>
                <button type="button" class="btn btn-sm btn-outline-primary fw-bold" onclick="addSignatory()">
                    <i class="bi bi-plus-lg me-1"></i> Add Signatory
                </button>
            </div>

            <!-- Signatory Error Alert -->
            <div id="signatory-error" class="alert alert-danger py-2 px-3 mb-3 fw-bold d-flex align-items-center" style="display: none;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Please enter at least one signatory (Name or Designation) before generating the report.
            </div>
            
            <div id="signatories-container">
                <!-- Signatory Row 1 -->
                <div class="row mb-2 signatory-row">
                    <div class="col-sm-5">
                        <input type="text" class="form-control setup-input sig-name" placeholder="Name (e.g. Juan Dela Cruz)" />
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control setup-input sig-designation" placeholder="Designation (e.g. School Head)" />
                    </div>
                    <div class="col-sm-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm mt-1" title="Remove" onclick="this.closest('.signatory-row').remove()">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <!-- Signatory Row 2 -->
                <div class="row mb-2 signatory-row">
                    <div class="col-sm-5">
                        <input type="text" class="form-control setup-input sig-name" placeholder="Name" />
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control setup-input sig-designation" placeholder="Designation" />
                    </div>
                    <div class="col-sm-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm mt-1" title="Remove" onclick="this.closest('.signatory-row').remove()">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2 mt-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Cancel</a>
            <button type="button" class="btn text-white px-4 fw-bold" style="background-color: var(--deped-blue, #0033A0); border-color: var(--deped-blue, #0033A0);" onclick="generateReport()">
                <i class="bi bi-file-earmark-check me-1"></i> Generate Report
            </button>
        </div>
    </div>

    <!-- ==========================================
         STEP 2: REPORT PREVIEW / PRINT AREA
         ========================================== -->
    <div id="report-section" style="display: none;">
        
        <!-- Action Controls -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mb-4 mx-auto gap-3 d-print-none" style="max-width: 1150px;">
            <button onclick="backToSetup()" class="btn btn-outline-secondary btn-sm fw-bold align-self-start align-self-sm-center">
                <i class="bi bi-arrow-left me-1"></i> Edit Signatories
            </button>
            
            <div class="d-flex gap-2">
                <!-- Native vector landscape print/save dialog -->
                <button onclick="window.print()" class="btn text-white shadow px-4 fw-bold" style="background-color: var(--deped-blue, #0033A0); border-color: var(--deped-blue, #0033A0);">
                    <i class="bi bi-printer me-1"></i> Print / Save as PDF (Landscape)
                </button>
            </div>
        </div>

        <!-- Printable Report Container -->
        <div id="pdf-content" class="report-wrapper">
            
            <!-- HEADER SECTION -->
            <div>
                <div class="text-center">
                    <div class="report-header-text">Republic of the Philippines</div>
                    <div class="report-header-text">Department of Education</div>
                    <div class="report-header-text">Division of Bohol</div>
                    <div class="report-header-text fs-6 mt-1 mb-1 fw-bold" style="color: var(--deped-blue, #0033A0); font-family: var(--font-header, 'Montserrat', sans-serif);">SUB-CONGRESSIONAL (LOCATU) • Calape, Bohol</div>
                </div>

                <div class="report-divider"></div>

                <div class="text-center mb-2">
                    <div class="report-title mb-1">OFFICIAL LOCATU SUB-CONGRESSIONAL MEET 2026 OFFICIAL REPORT</div>
                    <div class="fw-bold text-muted" style="font-size: 0.85rem;">School Year 2026–2027</div>
                </div>

                <div class="report-divider"></div>

                <!-- REPORT DATE & TIME BLOCK -->
                <div class="meta-container">
                    <div class="text-center py-1">
                        <span class="meta-label">REPORT DATE & TIME: </span>
                        <span class="meta-value">@DateTime.Now.ToString("MMMM dd, yyyy • h:mm tt")</span>
                    </div>
                </div>
            </div>

            <!-- TABLES SECTION -->
            <div class="tables-section">
                
                <!-- ROW 1: SECONDARY (LEFT) & ELEMENTARY (RIGHT) - CENTERED -->
                <div class="print-row-split">
                    <div class="table-container-half">
                        <h6 class="fw-bold text-center section-title">
                            SECONDARY DIVISION MEDAL TALLY
                        </h6>
                        <table class="table-report" id="secondary-table">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 10%;">Rank</th>
                                    <th style="width: 36%;">Team / Delegation</th>
                                    <th class="text-center" style="width: 13.5%;">Gold</th>
                                    <th class="text-center" style="width: 13.5%;">Silver</th>
                                    <th class="text-center" style="width: 13.5%;">Bronze</th>
                                    <th class="text-center" style="width: 13.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="secondary-tbody">
                                <!-- Populated via JavaScript -->
                            </tbody>
                        </table>
                    </div>

                    <div class="table-container-half">
                        <h6 class="fw-bold text-center section-title">
                            ELEMENTARY DIVISION MEDAL TALLY
                        </h6>
                        <table class="table-report" id="elementary-table">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 10%;">Rank</th>
                                    <th style="width: 36%;">Team / Delegation</th>
                                    <th class="text-center" style="width: 13.5%;">Gold</th>
                                    <th class="text-center" style="width: 13.5%;">Silver</th>
                                    <th class="text-center" style="width: 13.5%;">Bronze</th>
                                    <th class="text-center" style="width: 13.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="elementary-tbody">
                                <!-- Populated via JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- ROW 2: OVERALL MEDAL TALLY (CENTERED BELOW) -->
                <div class="print-row-center">
                    <div class="table-container-half">
                        <h6 class="fw-bold text-center section-title">
                            OVERALL MEDAL TALLY (COMBINED)
                        </h6>
                        <table class="table-report" id="overall-table">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 10%;">Rank</th>
                                    <th style="width: 36%;">Team / Delegation</th>
                                    <th class="text-center" style="width: 13.5%;">Gold</th>
                                    <th class="text-center" style="width: 13.5%;">Silver</th>
                                    <th class="text-center" style="width: 13.5%;">Bronze</th>
                                    <th class="text-center" style="width: 13.5%;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="overall-tbody">
                                <!-- Populated via JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- FOOTER SECTION -->
            <div class="footer-section">
                <h6 class="fw-bold mb-1 section-title">
                    CERTIFICATION
                </h6>
                <p class="cert-text">
                    This report is generated from the official LoCaTu Sub-Congressional Meet Management System and reflects the 
                    standings recorded across all divisions at the time of generation. Any subsequent game results or medal updates may 
                    affect the rankings shown in this document.
                </p>

                <div class="report-divider" style="margin-bottom: 10px;"></div>

                <!-- Dynamic Signatures Area -->
                <div class="row" id="dynamic-signatures">
                    <!-- Populated via JavaScript -->
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Raw dataset embedded from model
        const rawTallies = [
            @if(Model != null)
            {
                foreach (var tally in Model)
                {
                    var teamName = tally.Team?.Name ?? "Unknown Team";
                    var teamDivision = tally.Team?.Division ?? "Elementary";
                    @: { name: @Json.Serialize(teamName), division: @Json.Serialize(teamDivision), gold: @tally.Gold, silver: @tally.Silver, bronze: @tally.Bronze },
                }
            }
        ];

        // Function to dynamically append a new signatory input row
        function addSignatory() {
            const container = document.getElementById('signatories-container');
            const row = document.createElement('div');
            row.className = 'row mb-2 signatory-row';
            row.innerHTML = `
                <div class="col-sm-5">
                    <input type="text" class="form-control setup-input sig-name" placeholder="Name" />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control setup-input sig-designation" placeholder="Designation" />
                </div>
                <div class="col-sm-1 text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm mt-1" title="Remove" onclick="this.closest('.signatory-row').remove()">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            container.appendChild(row);
        }

        // Helper to sort and rank a list of tallies
        function getRankedTallies(list) {
            const sorted = [...list].sort((a, b) => {
                if (b.gold !== a.gold) return b.gold - a.gold;
                if (b.silver !== a.silver) return b.silver - a.silver;
                if (b.bronze !== a.bronze) return b.bronze - a.bronze;
                return a.name.localeCompare(b.name);
            });

            let ranked = [];
            let runningCount = 1;
            let displayRank = 1;
            let prev = null;

            sorted.forEach((item) => {
                if (prev !== null && item.gold === prev.gold && item.silver === prev.silver && item.bronze === prev.bronze) {
                    // Tie retains previous rank
                } else {
                    displayRank = runningCount;
                }
                ranked.push({ ...item, rank: displayRank });
                prev = item;
                runningCount++;
            });

            return ranked;
        }

        // Helper to render table rows into a given tbody selector
        function renderTableRows(tbodyId, dataList) {
            const tbody = document.getElementById(tbodyId);
            tbody.innerHTML = '';

            if (dataList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-2">No records available.</td></tr>`;
                return;
            }

            dataList.forEach(item => {
                const total = item.gold + item.silver + item.bronze;
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center fw-bold" style="color: var(--deped-blue, #0033A0);">${item.rank}</td>
                    <td class="fw-bold">${item.name}</td>
                    <td class="text-center medal-gold">${item.gold}</td>
                    <td class="text-center medal-silver">${item.silver}</td>
                    <td class="text-center medal-bronze">${item.bronze}</td>
                    <td class="text-center fw-bold" style="color: var(--deped-blue, #0033A0);">${total}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Function to capture form values, populate tables, and render the report UI
        function generateReport() {
            // 1. Fetch and validate signatories
            const sigRows = document.querySelectorAll('.signatory-row');
            const validSignatories = [];
            const sigError = document.getElementById('signatory-error');

            sigRows.forEach(row => {
                const nameInput = row.querySelector('.sig-name');
                const designationInput = row.querySelector('.sig-designation');
                
                const name = nameInput ? nameInput.value.trim() : '';
                const designation = designationInput ? designationInput.value.trim() : '';
                
                if (name !== '' || designation !== '') {
                    validSignatories.push({
                        name: name || '_________________________',
                        designation: designation || '_________________________'
                    });
                }
            });

            if (validSignatories.length === 0) {
                if (sigError) {
                    sigError.style.display = 'flex';
                }
                const firstInput = document.querySelector('.sig-name');
                if (firstInput) firstInput.focus();
                return; 
            }

            if (sigError) {
                sigError.style.display = 'none';
            }

            // 2. Secondary Table (Left)
            const secondaryList = rawTallies.filter(t => (t.division || '').toLowerCase() === 'secondary');
            const secondaryRanked = getRankedTallies(secondaryList);
            renderTableRows('secondary-tbody', secondaryRanked);

            // 3. Elementary Table (Right)
            const elementaryList = rawTallies.filter(t => (t.division || '').toLowerCase() === 'elementary');
            const elementaryRanked = getRankedTallies(elementaryList);
            renderTableRows('elementary-tbody', elementaryRanked);

            // 4. Overall Table (Combined)
            const overallMap = {};
            rawTallies.forEach(t => {
                const key = t.name.trim().toLowerCase();
                if (!overallMap[key]) {
                    overallMap[key] = { name: t.name, gold: 0, silver: 0, bronze: 0 };
                }
                overallMap[key].gold += t.gold;
                overallMap[key].silver += t.silver;
                overallMap[key].bronze += t.bronze;
            });
            const overallList = Object.values(overallMap);
            const overallRanked = getRankedTallies(overallList);
            renderTableRows('overall-tbody', overallRanked);

            // 5. Render all valid Signatories into the report signature section
            const sigContainer = document.getElementById('dynamic-signatures');
            sigContainer.innerHTML = ''; 

            validSignatories.forEach(sig => {
                const sigBlock = document.createElement('div');
                sigBlock.className = 'col sig-block';
                sigBlock.innerHTML = `
                    <div class="sig-title">${sig.name}</div>
                    <div class="sig-line">${sig.designation}</div>
                `;
                sigContainer.appendChild(sigBlock);
            });

            // 6. Hide Setup and Show Report
            document.getElementById('setup-section').style.display = 'none';
            document.getElementById('report-section').style.display = 'block';
        }

        // Function to go back and edit signatories
        function backToSetup() {
            document.getElementById('report-section').style.display = 'none';
            document.getElementById('setup-section').style.display = 'block';
        }
    </script>
}