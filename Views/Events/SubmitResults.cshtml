@model SubcongMeet.Models.Event
@{
    ViewData["Title"] = "Submit Results";
    var teams = ViewBag.Teams as List<SubcongMeet.Models.Team> ?? new List<SubcongMeet.Models.Team>();
    
    // FIX: Retrieve the numerical CoordinatorId from the user's claims
    var currentCoordinatorIdStr = User.FindFirst("CoordinatorId")?.Value 
        ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? User.FindFirst("Id")?.Value;

    // FIX: Compare the Model's CoordinatorId against the Claim's CoordinatorId instead of the Username
    bool isAuthorized = User.Identity?.IsAuthenticated == true && 
        (User.IsInRole("Admin") || (Model.CoordinatorId != null && Model.CoordinatorId.ToString() == currentCoordinatorIdStr));
}

<style>
    .glass-card { 
        background: white; 
        border-radius: 8px; 
        box-shadow: 0 4px 20px rgba(0,0,0,0.05); 
        border-top: 5px solid var(--deped-blue); 
    }
    
    .form-control-custom { 
        border: 1px solid #dee2e6; 
        border-radius: 6px; 
        font-family: var(--font-body);
        padding: 0.75rem 1rem;
    }
    
    .form-control-custom:focus { 
        border-color: var(--deped-blue); 
        box-shadow: 0 0 0 0.2rem rgba(0, 51, 160, 0.15); 
    }
    
    .modern-medal-box { 
        padding: 1.5rem; 
        border-radius: 8px; 
        background: var(--bg-light); 
        border: 1px solid #dee2e6;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .medal-label {
        font-family: var(--font-header);
        font-size: 1.1rem;
        text-transform: uppercase;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="container py-4 py-md-5">
    
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem;"><i class="bi bi-arrow-left"></i> Back to Events</a>
    </div>

    <div class="glass-card p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h2 class="mb-1" style="font-family: var(--font-header); color: var(--deped-blue);">
                    <i class="bi bi-shield-check text-warning me-2"></i> @(isAuthorized ? "OFFICIAL SCORING" : "MATCH RESULTS")
                </h2>
                <div class="d-flex gap-2 align-items-center mt-2">
                    <span class="badge" style="background: var(--bg-light); color: var(--deped-blue); border: 1px solid var(--deped-blue);">@Model.Division</span>
                    <span class="badge" style="background: var(--bg-light); color: var(--text-muted); border: 1px solid #dee2e6;">@Model.SportName</span>
                    <span class="fs-5 text-muted fw-bold">@Model.Title</span>
                </div>
            </div>
            @if(Model.Status == "Completed"){
                <span class="badge bg-success px-3 py-2">COMPLETED</span>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(Model.LastUpdatedBy)) {
            <div class="mb-4 p-3 rounded" style="background: rgba(0, 51, 160, 0.05); border: 1px solid rgba(0, 51, 160, 0.1);">
                <i class="bi bi-info-circle text-primary"></i> <span class="text-muted fw-bold" style="font-size: 0.85rem;">Last updated by: <span class="text-dark">@Model.LastUpdatedBy</span> 
                @if (Model.UpdatedAt.HasValue) { <span>on @Model.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span> }</span>
            </div>
        }
        
        <form asp-action="SubmitResults" method="post" onsubmit="return confirm('Are you sure you want to publish these official results?');">
            <input type="hidden" asp-for="Id" />
            <div class="row g-4 mb-5">
                <!-- GOLD -->
                <div class="col-md-4">
                    <div class="modern-medal-box" style="border-top: 5px solid #D4AF37;">
                        <label class="medal-label" style="color: #D4AF37;"><span>🥇</span> Gold Medalist</label>
                        <select asp-for="GoldTeamId" class="form-select form-control-custom mb-3" disabled="@(!isAuthorized)">
                            <option value="">-- Select Winning School --</option>
                            @foreach(var t in teams){<option value="@t.Id">@t.Name</option>}
                        </select>
                        <textarea asp-for="GoldWinnerName" class="form-control form-control-custom flex-grow-1" placeholder="@(isAuthorized ? "Athlete Name(s) (Optional)\nPress Enter for next line" : "")" rows="3" readonly="@(!isAuthorized)"></textarea>
                    </div>
                </div>
                <!-- SILVER -->
                <div class="col-md-4">
                    <div class="modern-medal-box" style="border-top: 5px solid #A0A0A0;">
                        <label class="medal-label" style="color: #6c757d;"><span>🥈</span> Silver Medalist</label>
                        <select asp-for="SilverTeamId" class="form-select form-control-custom mb-3" disabled="@(!isAuthorized)">
                            <option value="">-- Select Runner-up --</option>
                            @foreach(var t in teams){<option value="@t.Id">@t.Name</option>}
                        </select>
                        <textarea asp-for="SilverWinnerName" class="form-control form-control-custom flex-grow-1" placeholder="@(isAuthorized ? "Athlete Name(s) (Optional)\nPress Enter for next line" : "")" rows="3" readonly="@(!isAuthorized)"></textarea>
                    </div>
                </div>
                <!-- BRONZE -->
                <div class="col-md-4">
                    <div class="modern-medal-box" style="border-top: 5px solid #CD7F32;">
                        <label class="medal-label" style="color: #CD7F32;"><span>🥉</span> Bronze Medalist</label>
                        <select asp-for="BronzeTeamId" class="form-select form-control-custom mb-3" disabled="@(!isAuthorized)">
                            <option value="">-- Select 3rd Place --</option>
                            @foreach(var t in teams){<option value="@t.Id">@t.Name</option>}
                        </select>
                        <textarea asp-for="BronzeWinnerName" class="form-control form-control-custom flex-grow-1" placeholder="@(isAuthorized ? "Athlete Name(s) (Optional)\nPress Enter for next line" : "")" rows="3" readonly="@(!isAuthorized)"></textarea>
                    </div>
                </div>
            </div>
            
            <!-- Inside the form actions section -->
            @if (isAuthorized) {
                <div class="d-flex flex-column flex-sm-row justify-content-between pt-4" style="border-top: 1px solid #dee2e6;">
                    <div class="d-flex gap-2 mb-3 mb-sm-0">
                        <button type="button" class="btn btn-outline-danger fw-bold rounded-pill px-4" onclick="confirmClear()">Clear All Data</button>
                        
                        @* Only show Manage Qualifier if there are existing results *@
                        @if (Model.GoldTeamId.HasValue || Model.SilverTeamId.HasValue || Model.BronzeTeamId.HasValue)
                        {
                            <a asp-controller="Delegation" asp-action="Manage" asp-route-eventId="@Model.Id" class="btn btn-outline-success fw-bold rounded-pill px-4">
                                <i class="bi bi-people-fill"></i> Manage Delegation
                            </a>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-bold px-5 py-2 rounded-pill shadow-sm"><span>Publish Official Results</span></button>
                    </div>
                </div>
            }
        </form>
        @if (isAuthorized) { 
            <form id="clearForm" asp-action="ClearResults" method="post" style="display:none;"><input type="hidden" name="id" value="@Model.Id" /></form> 
        }
    </div>
</div>

@section Scripts { 
    <script> 
        function confirmClear() { 
            if (confirm('Are you sure you want to remove all results for this event? This will reset the medal tally for the involved schools.')) { 
                document.getElementById('clearForm').submit(); 
            } 
        } 
    </script> 
}