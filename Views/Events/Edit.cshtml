@model SubcongMeet.Models.Event
@{
    ViewData["Title"] = "Edit Event";
}

<style>
    .form-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border-top: 5px solid var(--golden-yellow);
    }
    
    .form-control-custom {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-family: var(--font-body);
    }
    
    .form-control-custom:focus {
        border-color: var(--deped-blue);
        box-shadow: 0 0 0 0.2rem rgba(0, 51, 160, 0.15);
    }
    
    label {
        font-family: var(--font-header);
        color: var(--text-muted);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-12">
            
            <div class="mb-4">
                <a asp-action="ManageEvents" class="text-decoration-none text-muted fw-bold" style="font-size: 0.85rem;"><i class="bi bi-arrow-left"></i> Back to Management</a>
            </div>

            <div class="form-card p-4 p-md-5">
                <h2 class="mb-4" style="font-family: var(--font-header); color: var(--deped-blue);">
                    <i class="bi bi-pencil-square text-warning me-2"></i>MODIFY EVENT
                </h2>
                
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label">Event Title</label>
                            <input asp-for="Title" class="form-control form-control-custom" required />
                        </div>

                        <!-- Coordinator Selection -->
                        <div class="col-12">
                            <label asp-for="CoordinatorId" class="form-label">Assigned Coordinator</label>
                            <select asp-for="CoordinatorId" asp-items="ViewBag.Coordinators" class="form-select form-control-custom">
                                <option value="">-- No Coordinator Assigned --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SportName" class="form-label">Sport Name</label>
                            <input asp-for="SportName" class="form-control form-control-custom" placeholder="e.g. Athletics, Basketball" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SportCategory" class="form-label">Category Type</label>
                            <select asp-for="SportCategory" class="form-select form-control-custom" required>
                                <option value="Individual">Individual</option>
                                <option value="Team">Team</option>
                                <option value="Demonstration">Demonstration</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Division" class="form-label">Division / Level</label>
                            <select asp-for="Division" class="form-select form-control-custom" required>
                                <option value="Elementary">Elementary</option>
                                <option value="Secondary">Secondary</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" class="form-select form-control-custom">
                                <option value="Pending">Pending</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-3 justify-content-end mt-5 pt-3" style="border-top: 1px solid #dee2e6;">
                        <a asp-action="ManageEvents" class="btn btn-light fw-bold" style="padding: 10px 24px; border-radius: 6px;">Cancel</a>
                        <button type="submit" class="btn-athletic" style="background-color: var(--deped-blue); color: white; padding: 10px 24px; border-radius: 6px; border: none;"><span>Save Changes</span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>